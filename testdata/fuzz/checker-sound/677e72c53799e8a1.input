local record R
  a: integer | nil
  b: integer | nil
  n: integer
end
local r: R = { a = 1, n = 0 }
local s: R = { b = 2, n = 0 }
local count: integer = 0
local sink: integer = 0
local nums: {integer} = { 1, 2, 3 }
local opts: {integer | nil} = { 1, 2, 3 }
local function maybe(): integer | nil
  count = count + 1
  if count % 3 == 0 then return nil end
  return count
end
local function pick(): R | nil
  count = count + 1
  if count % 3 == 0 then return nil end
  if count % 2 == 0 then return r end
  return s
end
local function touch(t: R)
  t.a = nil
  t.b = nil
end
local function id(v: integer | nil): integer | nil
  return v
end
local function g(n: integer | nil): integer
  local function reset() n = nil end
  if n then
    reset()
    return n + 1
  end
  return sink
end
sink = sink + g(1)
return sink
