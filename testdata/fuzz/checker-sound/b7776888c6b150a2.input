local record R
  a: integer | nil
  b: integer | nil
  n: integer
end
local r: R = { a = 1, n = 0 }
local s: R = { b = 2, n = 0 }
local record State
  count: integer
  sink: integer
end
local st: State = { count = 0, sink = 0 }
local nums: {integer} = { 1, 2, 3 }
local opts: {integer | nil} = { 1, 2, 3 }
local function maybe(): integer | nil
  st.count = st.count + 1
  if st.count % 3 == 0 then return nil end
  return st.count
end
local function pick(): R | nil
  st.count = st.count + 1
  if st.count % 3 == 0 then return nil end
  if st.count % 2 == 0 then return r end
  return s
end
local function touch(t: R)
  t.a = nil
  t.b = nil
end
local function id(v: integer | nil): integer | nil
  return v
end
for i = 1, 3 do
  if i == 2 then goto next end
  st.sink = st.sink + i
  ::next::
end
return st.sink
