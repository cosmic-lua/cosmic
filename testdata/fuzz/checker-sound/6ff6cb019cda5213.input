local function maybe(): integer | nil
  return nil
end
local function one(): integer | nil
  return 1
end
local x: integer | nil = one()
local sink: integer = 0
do
  local x = { value = x }
  if x.value == nil then return sink end
  local function clear() x.value = nil end
  clear()
  sink = sink + x.value + 1
end
return sink
