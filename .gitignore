# Build outputs
o/
cosmic-first
dist/
results/

# Generated binaries (allow specific scripts). `bin/*`, not `bin/`: git
# cannot re-include a path inside an excluded DIRECTORY, so `bin/` plus
# `!bin/cosmic` silently ignores the trust root instead of tracking it.
bin/*
!bin/cosmic
!bin/cosmic.pin

# ah agent harness
.ah/

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.*.swp

# Embedded env vars (may contain secrets)
env.d/*
!env.d/README

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
.ape*

# Test artifacts in root directory
/*.lua
!tlconfig.lua
/checkfile
/passthrough_*
/target
