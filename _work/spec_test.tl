#!/usr/bin/env cosmic
-- The spec bar's grammar: the two headings a spec must carry, what
-- counts as carrying one, and the one content check the lint can make
-- honestly — Acceptance holds a literal command. A heading with
-- nothing under it is a gap, because a pasted template is the failure
-- mode this exists to catch.
local spec = require("_work.spec")

--- A minimal bar-complete body for tests. Non-goals is optional
--- prose: it rides along and the bar has nothing to say about it.
local READY_BODY < const > = [[
## Change
Add the verb.

## Non-goals
No contract changes.

## Acceptance
`--make ci` ends `ci: PASS`.
]]

local function test_ready_gaps_complete()
  local gaps = spec.ready_gaps(READY_BODY)
  assert(#gaps == 0, "unexpected gaps: " .. table.concat(gaps, ", "))
end
test_ready_gaps_complete()

local function test_two_sections_suffice()
  local gaps = spec.ready_gaps("## Change\nAdd it.\n## Acceptance\n`ci`\n")
  assert(#gaps == 0,
    "Change and Acceptance are the whole bar: " .. table.concat(gaps, ", "))
end
test_two_sections_suffice()

local function test_ready_gaps_missing()
  local gaps = spec.ready_gaps("## Change\nstuff\n")
  assert(#gaps == 1, "expected 1 gap, got " .. tostring(#gaps))
  assert(gaps[1] == "Acceptance is missing or empty",
    "got: " .. tostring(gaps[1]))
end
test_ready_gaps_missing()

local function test_ready_gaps_case_and_level()
  local gaps = spec.ready_gaps("### CHANGE\nx\n## acceptance\n`x`\n")
  assert(#gaps == 0, "case/level should not matter: " .. table.concat(gaps, ", "))
end
test_ready_gaps_case_and_level()

local function test_ready_gaps_footer_is_not_content()
  local gaps = spec.ready_gaps(
    "## Change\nx\n"
    .. "## Acceptance\n\n---\n_Generated by a footer_\n")
  assert(#gaps == 1 and gaps[1] == "Acceptance is missing or empty",
    "footer below --- should not fill a section: " .. table.concat(gaps, ", "))
end
test_ready_gaps_footer_is_not_content()

local function test_ready_gaps_empty_section_counts()
  local gaps = spec.ready_gaps("## Change\n\n## Acceptance\n`x`\n")
  assert(#gaps == 1, "expected 1 gap, got " .. table.concat(gaps, ", "))
  assert(gaps[1] == "Change is missing or empty",
    "hollow heading should count as a gap")
end
test_ready_gaps_empty_section_counts()

-- Acceptance is the definition of done, so it has to be runnable: a
-- section with prose and no literal command is the "acceptance by
-- vibes" anti-pattern, and it is the one content failure the lint can
-- see rather than leaving to a bounce.
local function test_acceptance_needs_a_literal_command()
  local gaps = spec.ready_gaps(
    "## Change\nAdd the verb.\n## Acceptance\nworks correctly and is fast\n")
  assert(#gaps == 1 and gaps[1]:find("no literal command", 1, true),
    "prose acceptance is refused by shape: " .. table.concat(gaps, ", "))
  local ok = spec.ready_gaps(
    "## Change\nAdd the verb.\n## Acceptance\n- `wc -l < f` prints 3\n")
  assert(#ok == 0, "one backticked command satisfies it: "
    .. table.concat(ok, ", "))
  -- A missing Acceptance reports the missing section alone, not the
  -- command gap stacked on top of it.
  local missing = spec.ready_gaps("## Change\nAdd the verb.\n")
  assert(#missing == 1 and missing[1] == "Acceptance is missing or empty",
    "an absent section is one gap: " .. table.concat(missing, ", "))
end
test_acceptance_needs_a_literal_command()

-- `section_of` narrows a read to one section using the SAME heading
-- grammar the bar lints with: any level, case-insensitive on the
-- text, ended by the next heading or a thematic break.
local function test_section_of_narrows_to_one_section()
  local body = "## Goal\nserves G8\n\n# change\ndo the thing\n\n"
  .. "### Acceptance\nci: PASS\n\n---\na footer\n"
  local goal = spec.section_of(body, "Goal")
  assert(goal == "## Goal\nserves G8\n\n", ("goal was %q"):format(goal))
  assert(spec.section_of(body, "Change") == "# change\ndo the thing\n\n",
    "a heading at any level, matched case-insensitively")
  assert(spec.section_of(body, "acceptance")
    == "### Acceptance\nci: PASS\n\n",
    "the thematic break ends the last section")
  assert(spec.section_of(body, "Nonesuch") == "",
    "a section the body lacks is empty, not the whole body")
  assert(spec.section_of("", "Goal") == "", "an empty body has no sections")
end
test_section_of_narrows_to_one_section()

-- A revision is a content digest: same text, same revision; any edit,
-- a different one; and no sidecar at all is a stable constant.
local function test_revision_is_a_content_digest()
  local a = spec.revision(READY_BODY)
  assert(a == spec.revision(READY_BODY), "two readings agree")
  assert(#a == 64 and a:match("^[0-9a-f]+$"), "64 hex characters: " .. a)
  assert(a ~= spec.revision(READY_BODY .. "moved\n"), "any edit moves it")
  assert(spec.revision("") == spec.revision(""), "no sidecar is stable")
end
test_revision_is_a_content_digest()
