#!/usr/bin/env cosmic
-- The ready bar's section grammar: which headings a spec must carry,
-- and what counts as carrying one. A heading with nothing under it is
-- a gap, because a pasted template is the failure mode this exists to
-- catch.
local spec = require("_work.spec")

--- A minimal ready-bar-complete body for tests.
local READY_BODY < const > = [[
## Goal
G4 — via epic #12

## Change
Add the verb.

## Non-goals
No contract changes.

## Acceptance
`--make ci` ends `ci: PASS`.

## Enablement
none needed
]]

local function test_ready_gaps_complete()
  local gaps = spec.ready_gaps(READY_BODY)
  assert(#gaps == 0, "unexpected gaps: " .. table.concat(gaps, ", "))
end
test_ready_gaps_complete()

local function test_ready_gaps_missing()
  local gaps = spec.ready_gaps("## Goal\nG1\n\n## Change\nstuff\n")
  assert(#gaps == 3, "expected 3 gaps, got " .. tostring(#gaps))
  assert(gaps[1] == "Non-goals", "got: " .. tostring(gaps[1]))
  assert(gaps[2] == "Acceptance", "got: " .. tostring(gaps[2]))
  assert(gaps[3] == "Enablement", "got: " .. tostring(gaps[3]))
end
test_ready_gaps_missing()

local function test_ready_gaps_case_and_level()
  local gaps = spec.ready_gaps(
    "# goal\nx\n### CHANGE\nx\n## non-goals\nx\n## acceptance\nx\n## enablement\nx\n")
  assert(#gaps == 0, "case/level should not matter: " .. table.concat(gaps, ", "))
end
test_ready_gaps_case_and_level()

local function test_ready_gaps_footer_is_not_content()
  local gaps = spec.ready_gaps(
    "## Goal\nx\n## Change\nx\n## Non-goals\nx\n## Acceptance\nx\n"
    .. "## Enablement\n\n---\n_Generated by a footer_\n")
  assert(#gaps == 1 and gaps[1] == "Enablement",
    "footer below --- should not fill a section: " .. table.concat(gaps, ", "))
end
test_ready_gaps_footer_is_not_content()

local function test_ready_gaps_empty_section_counts()
  local gaps = spec.ready_gaps(
    "## Goal\n\n## Change\nreal content\n## Non-goals\nx\n"
    .. "## Acceptance\nx\n## Enablement\nx\n")
  assert(#gaps == 1, "expected 1 gap, got " .. table.concat(gaps, ", "))
  assert(gaps[1] == "Goal", "hollow heading should count as a gap")
end
test_ready_gaps_empty_section_counts()
