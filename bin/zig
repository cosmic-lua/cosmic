#!/bin/sh
# Fetch, verify and run the one pinned zig. The pin is bin/zig.pin: a
# version line, then one line per host naming the sha256 of that host's
# release tarball.
#
# The tarball is cached outside the tree, under $XDG_CACHE_HOME/cosmic/zig
# (default ~/.cache/cosmic/zig), so a clean `o/` never costs a download.
# COSMIC_ZIG names an already-installed zig binary and skips all of this.
#
# The fetch/verify/run logic itself is build/zig.tl, which bin/zig
# hands off to, run with `cosmic --standalone` -- against the bootstrap
# binary's own standard library, never the tree, so a core edit nobody
# has booted yet, or a broken file elsewhere in the tree, cannot stop
# the tool that rebuilds them:
#
#   bin/cosmic-bootstrap fetches, verifies and runs the release
#   ci/cosmic-driver.pin names, or $COSMIC_BOOTSTRAP when set (see it).
#
# zig itself always runs in the caller's working directory.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/build/zig.tl" "$@"
