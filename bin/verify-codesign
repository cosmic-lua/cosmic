#!/bin/sh
# Whether Zig's ad-hoc signature on a raw macOS core is one Apple's own
# tooling accepts, on macOS, and a no-op elsewhere: see
# build/verify_codesign.tl, which this runs with `cosmic --standalone` on
# bin/cosmic-bootstrap's cosmic: the pinned release, or $COSMIC_BOOTSTRAP
# when set.
#
#   bin/verify-codesign <path-to-macos-binary>
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/build/verify_codesign.tl" "$@"
