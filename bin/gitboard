#!/bin/sh
set -e

# The board's trust root: the same shape as bin/cosmic, one job
# smaller. Obtain the ONE pinned artifact named in bin/gitboard.pin — a
# gitboard release built by cosmic-lua/work's own gate — verify it,
# assimilate it, and exec it with whatever arguments it was given.
# Nothing is built here: the machinery's tree is for changing the
# machinery, and a session needs only the binary and a clone of the
# board's refs. The chain is
#
#     kernel -> this script -> one pin -> the board
#
# with POSIX sh, curl, sha256sum and od the whole host surface.
#
#     bin/gitboard sync          bring the board's refs up to date
#     bin/gitboard next          the one next action
#
# The state repository defaults to o/board under this checkout: the
# script exports GITBOARD_DIR when the caller has not, and every verb
# reads it as the default for --dir.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PIN="${SCRIPT_DIR}/gitboard.pin"
BOOTSTRAP="${ROOT}/o/bootstrap/gitboard"

verify_sha256() {
    file="$1"
    expected="$2"
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "${file}" | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "${file}" | cut -d' ' -f1)"
    else
        echo "no sha256 tool available to verify ${file}" >&2
        return 1
    fi
    [ "${actual}" = "${expected}" ]
}

download() {
    url="$1"
    dest="$2"
    dest_tmp="${dest}.tmp.$$"
    attempt=0
    until curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors \
        -o "${dest_tmp}" "${url}"; do
        attempt=$((attempt + 1))
        if [ "${attempt}" -ge 3 ]; then
            echo "Failed to download ${url} after ${attempt} attempts" >&2
            rm -f "${dest_tmp}"
            return 1
        fi
        echo "Retrying download of ${url} (attempt ${attempt})..." >&2
        sleep $((attempt * 5))
    done
    mv -f "${dest_tmp}" "${dest}"
}

ensure_bootstrap() {
    url="$(sed -n 's/^url *= *//p' "${PIN}")"
    sha256="$(sed -n 's/^sha256 *= *//p' "${PIN}")"
    if [ -z "${url}" ] || [ -z "${sha256}" ]; then
        echo "could not read url/sha256 from ${PIN}" >&2
        exit 1
    fi
    if [ -x "${BOOTSTRAP}" ] &&
        [ "$(cat "${BOOTSTRAP}.pin" 2>/dev/null)" = "${sha256}" ]; then
        return 0
    fi
    echo "Downloading pinned gitboard..." >&2
    mkdir -p "${ROOT}/o/bootstrap"
    boot_tmp="${BOOTSTRAP}.boot.$$"
    download "${url}" "${boot_tmp}" || exit 1
    if ! verify_sha256 "${boot_tmp}" "${sha256}"; then
        echo "pinned gitboard checksum verification failed; refusing to run" >&2
        rm -f "${boot_tmp}"
        exit 1
    fi
    chmod +x "${boot_tmp}"
    # A release may already be a native ELF; an APE is assimilated
    # through its own shell stub, since the program behind it does not
    # know the flag.
    if [ "$(head -c 4 "${boot_tmp}" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
        sh "${boot_tmp}" --assimilate
    fi
    if [ "$(head -c 4 "${boot_tmp}" | od -An -tx1 | tr -d ' \n')" != "7f454c46" ]; then
        echo "assimilation failed: still an APE" >&2
        rm -f "${boot_tmp}"
        exit 1
    fi
    mv -f "${boot_tmp}" "${BOOTSTRAP}"
    printf '%s\n' "${sha256}" > "${BOOTSTRAP}.pin"
}

cd "${ROOT}"
ensure_bootstrap

is_work_origin() {
    case "$(git -C "$1" remote get-url origin 2>/dev/null || true)" in
        */cosmic-lua/work | *:cosmic-lua/work | */cosmic-lua/work.git | *:cosmic-lua/work.git)
            return 0
            ;;
    esac
    return 1
}

# $1: a checkout directory whose ../work sibling might be the board.
# Prints the sibling and succeeds only when it exists and its origin
# is cosmic-lua/work.
probe_sibling_of() {
    dir="$1"
    if [ -d "${dir}/../work" ]; then
        sib="$(cd "${dir}/../work" && pwd)"
        if is_work_origin "${sib}"; then
            printf '%s\n' "${sib}"
            return 0
        fi
    fi
    return 1
}

# Prefer a sibling ../work clone of cosmic-lua/work over o/board, so a
# session that already carries one never diverges into a second, dead
# local-only board -- this used to be a shell snippet every session's
# bootstrap carried by hand (skills/work/SKILL.md); now the tool does
# it, and nothing else needs to. Run from a linked worktree (every
# builder's checkout, per `gitboard worktree`), the sibling lives
# beside the MAIN checkout, not beside the worktree, so a second probe
# resolves `git rev-parse --git-common-dir`'s parent when it differs
# from ROOT (relative `.git` in a main checkout, an absolute path to
# one in a linked worktree -- resolved with `cd`+`pwd` before the
# comparison so both forms compare equal to ROOT when they are ROOT).
# Under `set -e` every step here must succeed when there is no sibling
# and no git at all: each probe is directory-guarded or `|| true`d, so
# the o/board default below is reached either way.
if [ -z "${GITBOARD_DIR}" ]; then
    if candidate="$(probe_sibling_of "${ROOT}")"; then
        GITBOARD_DIR="${candidate}"
    else
        # --show-toplevel must equal ROOT before the common-dir is
        # trusted: git resolves both from any subdirectory of a
        # checkout, and ROOT here is a subdirectory (e.g. a fixture's
        # scratch root nested inside a real repo, or a caller running
        # from a subdirectory of its own checkout) whenever it does
        # not, so a match beyond ROOT itself would belong to some
        # unrelated enclosing repository, not ROOT's own.
        toplevel="$(git -C "${ROOT}" rev-parse --show-toplevel 2>/dev/null || true)"
        if [ -n "${toplevel}" ] && [ "${toplevel}" = "${ROOT}" ]; then
            common_dir="$(git -C "${ROOT}" rev-parse --git-common-dir 2>/dev/null || true)"
            if [ -n "${common_dir}" ]; then
                case "${common_dir}" in
                    /*) ;;
                    *) common_dir="${ROOT}/${common_dir}" ;;
                esac
                main_root="$(cd "${common_dir}/.." && pwd)"
                if [ "${main_root}" != "${ROOT}" ]; then
                    if candidate="$(probe_sibling_of "${main_root}")"; then
                        GITBOARD_DIR="${candidate}"
                    fi
                fi
            fi
        fi
    fi
fi
GITBOARD_DIR="${GITBOARD_DIR:-${ROOT}/o/board}"
export GITBOARD_DIR
exec "${BOOTSTRAP}" "$@"
