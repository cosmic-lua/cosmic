#!/bin/sh
# Refetch vendored trees from the archives their PINs name, keeping only
# what the build reads: `bin/vendor [name...]`, every tree by default.
#
# All the logic now lives in build/vendor.tl, run by the tree's own
# cosmic: fetching into $XDG_CACHE_HOME/cosmic/vendor (default
# ~/.cache/cosmic/vendor) with cosmic.http's sha256 check, walking
# whatever archive format it turns out to be with cosmic.archive, and
# rewriting the tree -- no curl, wget, tar, unzip or sha256sum needed.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cosmic=$root/o/bin/cosmic

[ -x "$cosmic" ] || {
  printf 'bin/vendor: no %s; run bin/zig build boot first\n' "$cosmic" >&2
  exit 1
}

exec "$cosmic" "$root/build/vendor.tl" "$@"
