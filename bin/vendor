#!/bin/sh
# Refetch vendored trees from the archives their PINs name, keeping only
# what the build reads: `bin/vendor [name...]`, every tree by default.
#
# All the logic lives in build/vendor.tl, run with `cosmic --standalone`:
# against that binary's own standard library, never the tree, so it
# works from any directory, writes nothing under o/, and does not care
# whether the tree has been booted. It fetches into
# $XDG_CACHE_HOME/cosmic/vendor (default ~/.cache/cosmic/vendor) with
# cosmic.http's sha256 check and unpacks with cosmic.archive -- no curl,
# wget, tar, unzip or sha256sum needed.
#
# The cosmic it runs: $COSMIC_BOOTSTRAP when set (it must be an
# executable file); else the pinned release bin/cosmic-bootstrap fetches.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script=$root/build/vendor.tl

die() {
  printf 'bin/vendor: %s\n' "$1" >&2
  exit 1
}

if [ -n "${COSMIC_BOOTSTRAP:-}" ]; then
  if [ ! -f "$COSMIC_BOOTSTRAP" ] || [ ! -x "$COSMIC_BOOTSTRAP" ]; then
    die "COSMIC_BOOTSTRAP=$COSMIC_BOOTSTRAP is not an executable file"
  fi
  exec "$COSMIC_BOOTSTRAP" --standalone "$script" "$@"
fi
exec "$root/bin/cosmic-bootstrap" --standalone "$script" "$@"
