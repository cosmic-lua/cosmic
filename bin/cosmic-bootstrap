#!/bin/sh
# The one piece of shell the tree means to keep: fetch, verify and
# cache the pinned bootstrap cosmic -- or take COSMIC_BOOTSTRAP's, below
# -- then print the entry point that runs it (no arguments; see print_entry),
# print its own path (`--raw-path`) or run it with the arguments given.
# Every other build script is Teal this binary runs standalone
# -- build/zig.tl behind bin/zig, build/vendor.tl behind bin/vendor,
# build/verify_codesign.tl behind bin/verify-codesign, each a one-line
# `exec` of this script -- against its own embedded standard library,
# so neither the tree's state nor its build directory matters to it.
#
# What this runs is written in the new checker's grammar, and the release
# reads that grammar when COSMIC_GRAMMAR=new, which this script sets for
# whatever it runs (a stand-in too). `--standalone` on a file of this
# checkout is refused unless ci/bootstrap-files.txt lists it (below); ci.yml's
# checked job type-checks the listed files on the pinned driver
# (`cosmic-driver cosmic_ci/driver.tl check-islands`), and `cosmic-driver
# test cosmic_ci` compiles ci/ on the pinned release.
#
# COSMIC_BOOTSTRAP, when set, names another cosmic to stand in for the
# pin's -- the tree's own tool, say -- for every one of them, and
# for CI's driver. It must be an executable file; anything else is an
# error, never a silent fallback to the pin. Nothing is fetched then,
# and the path printed or run is absolute, so a caller that changes
# directory still finds it. With COSMIC_BOOTSTRAP_VERIFY, which asks for
# the pin's digest-checked cosmic, it is refused.
#
# The pin is ci/cosmic-driver.pin, the release CI runs as its driver
# too: a commit, that commit's release URL, and the binary's sha256, one
# per line. The binary is cached by digest, as
# $XDG_CACHE_HOME/cosmic/bootstrap/cosmic-<sha256> (default
# ~/.cache/cosmic/bootstrap/...). It is downloaded to a .part file
# beside that name, checked against the pin, made executable, and only
# then renamed into place, so a file at that name is always a verified
# one: a warm run reads the pin and nothing else.
#
# A download that fails, or whose sha256 is not the pin's, is tried
# again from an empty .part file, with a growing pause between tries, up
# to COSMIC_BOOTSTRAP_ATTEMPTS times (default 5).
#
# A cache this script did not fill (CI restores one from actions/cache)
# is checked again when COSMIC_BOOTSTRAP_VERIFY is set: a cached file
# whose sha256 is not the pin's is removed and fetched afresh.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
pin=$root/ci/cosmic-driver.pin

die() {
  printf 'bin/cosmic-bootstrap: %s\n' "$1" >&2
  exit 1
}

# A file of this checkout runs on a cosmic the tree does not control standalone
# only as `--standalone <file>`, or `<file>` under COSMIC_STANDALONE=1, which is
# the same run, and only if ci/bootstrap-files.txt lists it: `check-islands`
# (ci/README.md) type-checks exactly those on the pinned release. The one other
# way a file reaches the release, `<file>` alone, builds the tree around it,
# which is how CI runs its own driver (`cosmic-driver cosmic_ci/driver.tl`)
# from ci/, a project `check-islands` checks as a whole: it is allowed for a file
# under the checkout's ci/ and refused for any other of the checkout. The
# target and the checkout are compared as `pwd -P` resolves them, a link in the
# file's own name followed, so a link from outside into the checkout does not
# get around it, and a target whose directory cannot be resolved is refused,
# not let by. A file outside the checkout is not this script's to hold. The
# list is read as ci/cosmic_ci/bootstrap_list.tl reads it, and as
# build/ci_tree_test.tl, which cannot require ci/, copies: one path a line,
# what a `#` starts dropped, white space (a CR too) trimmed from both ends.
check_listed() {
  check_target "$1" listed
}

# check_target FILE listed|project: the refusals above for FILE.
check_target() {
  target=$1
  hops=0
  while [ -L "$target" ] && [ "$hops" -lt 40 ]; do
    link=$(readlink "$target")
    case $link in
      /*) target=$link ;;
      *) target=$(dirname -- "$target")/$link ;;
    esac
    hops=$((hops + 1))
  done
  tdir=$(CDPATH= cd -- "$(dirname -- "$target")" 2>/dev/null && pwd -P) ||
    die "cannot resolve the directory of $1, so cannot tell whether it is a file of this checkout; refusing it"
  physical=$(CDPATH= cd -- "$root" && pwd -P)
  full=$tdir/$(basename -- "$target")
  case $full in
    "$physical"/*)
      relative=${full#"$physical"/}
      if [ "$2" = project ]; then
        case $relative in
          ci/*) return 0 ;;
        esac
        die "$relative is a file of the checkout outside ci/, which runs on the pinned release only as \`--standalone <file>\`, listed in ci/bootstrap-files.txt"
      fi
      [ -f "$root/ci/bootstrap-files.txt" ] ||
        die "no $root/ci/bootstrap-files.txt, which lists the files of the checkout that may run --standalone"
      if ! sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$root/ci/bootstrap-files.txt" |
          grep -Fxq -- "$relative"; then
        die "$relative is not in ci/bootstrap-files.txt, so it is not type-checked on the pinned release: list it there, then run \`cosmic-driver cosmic_ci/driver.tl check-islands\` from ci/"
      fi
      ;;
  esac
}

case "${1-}" in
  --standalone)
    [ "$#" -ge 2 ] && [ -n "$2" ] || die "--standalone names no file"
    check_listed "$2"
    ;;
  *.tl)
    if [ "${COSMIC_STANDALONE-}" = 1 ]; then
      check_listed "$1"
    else
      check_target "$1" project
    fi
    ;;
esac

# With no arguments this script answers where to run the release, and what it
# answers is an entry point that applies the check above to whatever it is run
# with and then runs the release, never the release itself: a caller that holds
# the entry point cannot run an unlisted file, however it spells the command.
# The entry point is generated beside the cache the release is in, for this
# checkout, and runs this script with COSMIC_BOOTSTRAP_ENTRY naming the release,
# so nothing is fetched. That variable is this script's alone: it is dropped
# before the release runs, so a release started through an entry point sees
# the environment its caller gave, COSMIC_BOOTSTRAP unset (the tree's tools
# read it to mean a stand-in toolchain, and keep no compile memo under it). `--raw-path` alone asks for the release's own path, for
# a caller that must read or copy the binary (ci/README.md lists them).
print_entry() {
  raw=$1
  if [ -n "${XDG_CACHE_HOME:-}" ]; then
    entries=$XDG_CACHE_HOME/cosmic/bootstrap
  else
    entries=${HOME:?HOME is unset}/.cache/cosmic/bootstrap
  fi
  mkdir -p "$entries"
  sum=$(printf '%s\n%s\n' "$root" "$raw" | cksum | cut -d' ' -f1)
  entry=$entries/entry-$sum
  quote_raw=$(printf '%s' "$raw" | sed "s/'/'\\\\''/g")
  quote_root=$(printf '%s' "$root" | sed "s/'/'\\\\''/g")
  part=$entries/.entry-$sum.$$.part
  {
    printf '#!/bin/sh\n'
    printf '# Generated by bin/cosmic-bootstrap: runs the release with the list check of that script.\n'
    printf '[ "$#" -ne 0 ] || exec '"'%s'"'\n' "$quote_raw"
    printf 'COSMIC_BOOTSTRAP_ENTRY='"'%s'"' exec '"'%s/bin/cosmic-bootstrap'"' "$@"\n' "$quote_raw" "$quote_root"
  } > "$part"
  chmod 755 "$part"
  mv -f "$part" "$entry"
  printf '%s\n' "$entry"
}

# Run by an entry point (print_entry): the release is named, the check above is
# made, and the name is dropped from the environment before it runs.
if [ -n "${COSMIC_BOOTSTRAP_ENTRY:-}" ]; then
  release=$COSMIC_BOOTSTRAP_ENTRY
  unset COSMIC_BOOTSTRAP_ENTRY
  if [ ! -f "$release" ] || [ ! -x "$release" ]; then
    die "the entry point's release $release is not an executable file"
  fi
  exec env COSMIC_GRAMMAR=new "$release" "$@"
fi

if [ -n "${COSMIC_BOOTSTRAP:-}" ]; then
  if [ -n "${COSMIC_BOOTSTRAP_VERIFY:-}" ]; then
    die "COSMIC_BOOTSTRAP and COSMIC_BOOTSTRAP_VERIFY are both set: a stand-in is no digest-checked cosmic"
  fi
  if [ ! -f "$COSMIC_BOOTSTRAP" ] || [ ! -x "$COSMIC_BOOTSTRAP" ]; then
    die "COSMIC_BOOTSTRAP=$COSMIC_BOOTSTRAP is not an executable file"
  fi
  # bin/cosmic asks this script where the tool is, so a stand-in of it
  # would call itself without end.
  if [ "$COSMIC_BOOTSTRAP" -ef "$root/bin/cosmic" ] ||
      [ "$COSMIC_BOOTSTRAP" -ef "$root/bin/cosmic-bootstrap" ]; then
    die "COSMIC_BOOTSTRAP=$COSMIC_BOOTSTRAP is this checkout's entrypoint, not a cosmic; name a built one"
  fi
  case $COSMIC_BOOTSTRAP in
    /*) ;;
    *) COSMIC_BOOTSTRAP=$(pwd)/$COSMIC_BOOTSTRAP ;;
  esac
  if [ "$#" -eq 0 ]; then
    print_entry "$COSMIC_BOOTSTRAP"
    exit 0
  fi
  if [ "$#" -eq 1 ] && [ "$1" = --raw-path ]; then
    printf '%s\n' "$COSMIC_BOOTSTRAP"
    exit 0
  fi
  exec env COSMIC_GRAMMAR=new "$COSMIC_BOOTSTRAP" "$@"
fi

[ -f "$pin" ] || die "no pin at $pin"
[ "$(wc -l < "$pin" | tr -d ' ')" = 3 ] || die "$pin is not three lines"
commit=$(sed -n '1p' "$pin")
url=$(sed -n '2p' "$pin")
digest=$(sed -n '3p' "$pin")
case $commit in *[!0-9a-f]* | '') die "$pin: line 1 is not a commit" ;; esac
[ "${#commit}" -eq 40 ] || die "$pin: line 1 is not a commit"
case $digest in *[!0-9a-f]* | '') die "$pin: line 3 is not a sha256" ;; esac
[ "${#digest}" -eq 64 ] || die "$pin: line 3 is not a sha256"
[ "$url" = "https://github.com/cosmic-lua/cosmic/releases/download/next-$commit/cosmic" ] ||
  die "$pin: line 2 is not the release of line 1's commit"

attempts=${COSMIC_BOOTSTRAP_ATTEMPTS:-5}
case $attempts in
  [1-9] | 1[0-9] | 20) ;;
  *) die "COSMIC_BOOTSTRAP_ATTEMPTS=$attempts is not a count from 1 to 20" ;;
esac

if [ -n "${XDG_CACHE_HOME:-}" ]; then
  cache=$XDG_CACHE_HOME/cosmic/bootstrap
else
  cache=${HOME:?HOME is unset}/.cache/cosmic/bootstrap
fi
cached=$cache/cosmic-$digest

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d' ' -f1
  else
    die "need sha256sum or shasum to verify $url"
  fi
}

if [ -n "${COSMIC_BOOTSTRAP_VERIFY:-}" ] && { [ -e "$cached" ] || [ -L "$cached" ]; }; then
  if [ -L "$cached" ] || [ ! -f "$cached" ]; then
    rm -f "$cached" || die "cannot remove $cached, which is not the pin's"
  else
    # An assignment, so a missing hash tool stops the script here.
    got=$(sha256_file "$cached")
    if [ "$got" != "$digest" ]; then
      rm -f "$cached" || die "cannot remove $cached, which is not the pin's"
    fi
  fi
fi

if [ ! -x "$cached" ]; then
  mkdir -p "$cache"
  partial=$cache/.cosmic-$digest.$$.part
  trap 'rm -f "$partial"' EXIT
  trap 'rm -f "$partial"; exit 1' HUP INT TERM
  if command -v curl >/dev/null 2>&1; then
    # One attempt gives up on no connection in 30 s, or on a stalled
    # stream, under 1 KiB/s for 60 s straight. The release is the one
    # source, and a slow link slows it and nothing else, so there is no
    # ceiling on a transfer that keeps moving: this catches a dead
    # stream, not a slow one.
    fetch() {
      curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
        --output "$partial" "$url"
    }
  elif command -v wget >/dev/null 2>&1; then
    # wget has no minimum speed, so 30 s of silence ends an attempt. It
    # makes one try (its default is 20); the loop below makes the rest.
    fetch() { wget -q --timeout=30 --tries=1 -O "$partial" "$url"; }
  else
    die "need curl or wget to fetch $url"
  fi
  # A shell loop rather than curl's --retry, which skips most failures
  # before 7.71's --retry-all-errors and which wget lacks: one network
  # blip should not fail a CI job. Every attempt starts from no partial
  # file, and a download whose digest is wrong is tried again too, since
  # a truncated transfer can end without an error.
  attempt=1
  while :; do
    rm -f "$partial"
    started=$(date +%s)
    if fetch; then
      got=$(sha256_file "$partial")
      [ "$got" = "$digest" ] && break
      why="$url has sha256 $got; the pin says $digest"
    else
      why="download failed after $(($(date +%s) - started)) s: $url"
    fi
    if [ "$attempt" -ge "$attempts" ]; then
      [ "$attempt" -eq 1 ] && die "$why (after 1 attempt)"
      die "$why (after $attempt attempts)"
    fi
    printf 'bin/cosmic-bootstrap: %s; retrying in %ss\n' "$why" "$((attempt * 2))" >&2
    sleep "$((attempt * 2))"
    attempt=$((attempt + 1))
  done
  chmod 755 "$partial"
  # Another process may have won the race; its file is the same bytes.
  mv -f "$partial" "$cached"
  trap - EXIT HUP INT TERM
fi

if [ "$#" -eq 0 ]; then
  print_entry "$cached"
  exit 0
fi
if [ "$#" -eq 1 ] && [ "$1" = --raw-path ]; then
  printf '%s\n' "$cached"
  exit 0
fi
exec env COSMIC_GRAMMAR=new "$cached" "$@"
