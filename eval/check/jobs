#!/bin/sh
# Grades the jobs task in an arena: see eval/check/grade.tl, which this
# runs with `cosmic --standalone` on bin/cosmic-bootstrap's cosmic: the
# pinned release, or $COSMIC_BOOTSTRAP when set.
#
#   eval/check/jobs <dir>
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/eval/check/grade.tl" jobs "$@"
