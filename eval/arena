#!/bin/sh
# Lays out an arena for one eval: see eval/arena.tl, which this runs with
# `cosmic --standalone` on $COSMIC_BOOTSTRAP when set (it must be an
# executable file), else on the pinned release bin/cosmic-bootstrap
# fetches.
#
#   eval/arena <task> <cosmic-binary> <dir>
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script=$root/eval/arena.tl

if [ -n "${COSMIC_BOOTSTRAP:-}" ]; then
  if [ ! -f "$COSMIC_BOOTSTRAP" ] || [ ! -x "$COSMIC_BOOTSTRAP" ]; then
    printf 'eval/arena: COSMIC_BOOTSTRAP=%s is not an executable file\n' "$COSMIC_BOOTSTRAP" >&2
    exit 1
  fi
  exec "$COSMIC_BOOTSTRAP" --standalone "$script" "$@"
fi
exec "$root/bin/cosmic-bootstrap" --standalone "$script" "$@"
