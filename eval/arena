#!/bin/sh
# Lays out an arena for one eval: see eval/arena.tl, which this runs with
# `cosmic --standalone` on bin/cosmic-bootstrap's cosmic: the pinned
# release, or $COSMIC_BOOTSTRAP when set.
#
#   eval/arena <task> <cosmic-binary> <dir>
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/eval/arena.tl" "$@"
