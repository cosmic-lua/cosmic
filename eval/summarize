#!/bin/sh
# Numbers from a Claude Code stream-json transcript, and the tool calls
# that left the arena or named this repository: see eval/summarize.tl,
# which this runs with `cosmic --standalone` on bin/cosmic-bootstrap's
# cosmic: the pinned release, or $COSMIC_BOOTSTRAP when set.
#
#   eval/summarize <arena>/transcript.jsonl
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/eval/summarize.tl" "$@"
