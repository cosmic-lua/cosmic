#!/bin/sh
# Runs the evals of cosmic agent itself -- fixed tasks, each tool's runs,
# their grades and what they spent: see eval/agent.tl, which this runs
# with `cosmic --standalone` on bin/cosmic-bootstrap's cosmic: the pinned
# release, or $COSMIC_BOOTSTRAP when set.
#
#   eval/agent --tool NAME=PATH [--tool NAME=PATH ...] --fixture DIR --out DIR
#              [--tasks T,...|all] [--reps N] [--model M] [--timeout S]
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/bin/cosmic-bootstrap" --standalone "$root/eval/agent.tl" "$@"
