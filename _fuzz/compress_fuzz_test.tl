--- Fuzz properties for cosmic.compress: decompress consumes untrusted
--- bytes (archives, fetched bodies), so it must invert compress exactly
--- and reject corruption loudly — a string result or `nil, message`,
--- never a throw.
--- env: FUZZ_SEED FUZZ_ITERS

local check = require("cosmic.check")
local compress = require("cosmic.compress")
local driver = require("_fuzz.driver")

local ROUND_TRIP_MAX_LEN = 4096
local CORRUPT_MAX_LEN = 512
local MUTATION_PLAINTEXT_MAX_LEN = 4096
local MAX_MUTATIONS = 4
local MOTIF_MAX_LEN = 8

-- compress()'s own documented format enum: "zlib" (default), "gzip"
-- and "raw" (headerless). The round-trip property iterates every one
-- of them since compress/decompress must invert exactly under each
-- framing the module documents.
local FORMATS: {compress.CompressFormat} = {"zlib", "gzip", "raw"}

--- Draw a highly repetitive string: a short random motif tiled to fill
--- the length. Arbitrary bytes from driver.bytes are already exercised
--- by the corrupt/mutation properties; this generator gives the
--- round-trip property real compressible data too, not only the
--- near-incompressible case random bytes produce.
--- @param max_len integer The longest string to produce
--- @return string The generated bytes
local function repetitive_bytes(max_len: integer): string
  if max_len < 1 then
    return ""
  end
  local motif = driver.bytes(math.random(1, math.min(MOTIF_MAX_LEN, max_len)))
  if #motif == 0 then
    motif = string.char(math.random(0, 255))
  end
  local n = math.random(0, max_len)
  local out: {string} = {}
  local have = 0
  while have < n do
    out[#out + 1] = motif
    have = have + #motif
  end
  return table.concat(out):sub(1, n)
end

--- Generate a round-trip input: mostly arbitrary bytes (covering empty,
--- tiny and multi-KB), occasionally a repetitive motif so the property
--- also exercises real compression rather than only the incompressible
--- case.
--- @return string The generated bytes
local function gen_round_trip_input(): string
  if math.random(1, 4) == 1 then
    return repetitive_bytes(ROUND_TRIP_MAX_LEN)
  end
  return driver.bytes(ROUND_TRIP_MAX_LEN)
end

local function test_round_trip_identity()
  local ok, msg = driver.run({
      name = "compress_round_trip_identity",
      gen = gen_round_trip_input,
      check = function(input: string): boolean, string
        for _, format in ipairs(FORMATS) do
          local packed, cerr = compress.compress(input, {format = format})
          if not packed then
            return false,
            string.format("compress(format=%s) failed: %s", format, tostring(cerr))
          end
          local out, derr = compress.decompress(packed,
            -- cast: CompressFormat's word set nests inside DecompressFormat's
            {format = format as compress.DecompressFormat})
          if not out then
            return false,
            string.format("decompress(format=%s) failed: %s", format, tostring(derr))
          end
          if out ~= input then
            return false, string.format(
              "format=%s: round trip mismatch (in=%d bytes, out=%d bytes)",
              format, #input, #out)
          end
        end
        return true
      end,
    })
  check.truthy(ok, msg)
end
test_round_trip_identity()

local function test_corrupt_totality()
  local ok, msg = driver.run({
      name = "compress_corrupt_totality",
      gen = function(): string
        return driver.bytes(CORRUPT_MAX_LEN)
      end,
      check = function(input: string): boolean, string
        local out, err = compress.decompress(input)
        if out == nil then
          if err == nil or #err == 0 then
            return false, "nil result with no error message"
          end
        end
        return true
      end,
    })
  check.truthy(ok, msg)
end
test_corrupt_totality()

--- Compress a random plaintext under the default framing, then apply
--- 1-4 random single-byte edits to the compressed bytes.
--- @return string The mutated compressed bytes
local function gen_mutated_compressed(): string
  local plaintext = driver.bytes(MUTATION_PLAINTEXT_MAX_LEN)
  local packed = check.must(compress.compress(plaintext))
  return driver.mutate(packed, math.random(1, MAX_MUTATIONS))
end

-- Bound: a mutation can land in a bit the format never reads (padding,
-- an unused flag) and produce output identical to the pre-mutation
-- plaintext even though the checksum machinery exists to catch
-- corruption in general — that outcome is a legitimate pass, not a
-- bug, because the property does not know whether a given mutation hit
-- checked or dead bits. So this property asserts totality and error
-- shape only (a string, or nil plus a string message, never a throw)
-- and deliberately does NOT assert decompress detects every mutation.
local function test_mutation_totality()
  local ok, msg = driver.run({
      name = "compress_mutation_totality",
      gen = gen_mutated_compressed,
      check = function(mutated: string): boolean, string
        local out, err = compress.decompress(mutated)
        if out == nil then
          if err == nil or #err == 0 then
            return false, "nil result with no error message"
          end
        end
        return true
      end,
    })
  check.truthy(ok, msg)
end
test_mutation_totality()
