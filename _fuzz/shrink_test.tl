local check = require("cosmic.check")
local driver = require("_fuzz.driver")
local rand = require("cosmic.rand")
local shrink = require("_fuzz.shrink")
local source = require("_fuzz.source")

--- Record the draws generated by running `gen` once through a fresh
--- seeded Recorder, so a test can shrink() them.
local function record_draws(seed: integer, gen: function(src: source.Recorder): string)
  : {source.Draw}, string
  local rec = source.new(rand.insecure_source(seed))
  local input = gen(rec)
  return rec.draws, input
end

local function test_shrinks_a_long_string_to_the_boundary_length()
  local gen = function(src: source.Recorder): string
    return driver.bytes(src, 64)
  end
  local fails_over_five = function(input: string): boolean, string
    return #input <= 5, "too long"
  end
  local draws: {source.Draw}
  local input: string
  local seed = 1
  repeat
    draws, input = record_draws(seed, gen)
    seed = seed + 1
  until #input > 5 or seed > 200
  check.truthy(#input > 5, "no seed produced a failing input to shrink")

  local minimized, attempts = shrink.shrink(gen, fails_over_five, draws)
  local replayed = source.replay(minimized)
  local minimized_input = gen(replayed)
  check.equal(#minimized_input, 6, "expected the minimal failing length")
  check.truthy(attempts > 0, "shrink should have made at least one attempt")
end
test_shrinks_a_long_string_to_the_boundary_length()

local function test_shrinks_an_int_draw_toward_its_lower_bound()
  local gen = function(src: source.Recorder): string
    local n = src:int(0, 1000)
    return tostring(n)
  end
  local fails_over_200 = function(input: string): boolean, string
    return tonumber(input) <= 200, "too big"
  end
  local draws: {source.Draw}
  local input: string
  local seed = 1
  repeat
    draws, input = record_draws(seed, gen)
    seed = seed + 1
  until tonumber(input) > 200 or seed > 200
  check.truthy(tonumber(input) > 200, "no seed produced a failing input to shrink")

  local minimized = shrink.shrink(gen, fails_over_200, draws)
  local replayed = source.replay(minimized)
  local minimized_input = gen(replayed)
  check.equal(minimized_input, "201", "expected the smallest failing int")
end
test_shrinks_an_int_draw_toward_its_lower_bound()

local function test_a_diverging_replay_does_not_throw_during_shrink()
  -- The generator's second draw only happens when the first is odd,
  -- so deleting draws can make a replay ask for a draw that is not
  -- there, or use a recorded value the generator does not expect.
  local gen = function(src: source.Recorder): string
    local n = src:int(0, 100)
    if n % 2 == 1 then
      local m = src:int(0, 100)
      return tostring(n) .. "," .. tostring(m)
    end
    return tostring(n)
  end
  local always_fails = function(_input: string): boolean, string
    return false, "always fails"
  end
  local draws = record_draws(3, gen)
  local ok, minimized = pcall(function(): {source.Draw}
      return (shrink.shrink(gen, always_fails, draws))
    end)
  check.truthy(ok, "shrink must not throw on a diverging replay: " .. tostring(minimized))
end
test_a_diverging_replay_does_not_throw_during_shrink()

local function test_shrink_respects_its_attempt_budget()
  -- A generator with a large, always-failing draw sequence exercises
  -- the ddmin pass heavily; shrink must still return within budget.
  local gen = function(src: source.Recorder): string
    return driver.bytes(src, 6000)
  end
  local always_fails = function(_input: string): boolean, string
    return false, "always fails"
  end
  local draws: {source.Draw}
  local seed = 1
  repeat
    draws = record_draws(seed, gen)
    seed = seed + 1
  until #draws > 5000 or seed > 200
  check.truthy(#draws > 5000, "no seed produced a large enough draw sequence, got " .. #draws)
  local _minimized, attempts = shrink.shrink(gen, always_fails, draws)
  check.truthy(attempts <= 20000, "shrink exceeded its attempt budget: " .. attempts)
end
test_shrink_respects_its_attempt_budget()
