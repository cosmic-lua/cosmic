--- Fuzz properties for what `cosmic refresh` reads from upstream: a PEM
--- bundle (`roots.parse`), the date curl names it by, and PyPI's
--- description of tzdata. Each is total -- a refusal by
--- name, never a raise -- and reads well-formed input back as written.
--- `FUZZ_SEED` and `FUZZ_ITERS` pick the inputs (build/fuzz/init.tl).

local Codec = require("cosmic.codec")
local Fs = require("cosmic.fs")
local Fuzz = require("build.fuzz")
local Http = require("cosmic.http")
local Json = require("cosmic.json")
local refresh = require("build.refresh")
local roots = require("build.roots")
local type Declared = require("build.inputs").Declared

--- The tree's CA bundle, which the parser is fuzzed from.
local _inputs: Declared = { reads = { "vendor/cacert/cacert.pem" } }

--- A DER sequence around `body`, its length in the short or long form.
local function sequence(body: string): string
  local n = #body
  if n < 0x80 then return "\x30" .. string.char(n) .. body end
  if n < 0x100 then return "\x30\x81" .. string.char(n) .. body end
  return "\x30\x82" .. string.pack(">I2", n) .. body
end

local function block(der: string, label: string): string
  local encoded = Codec.base64(der)
  local lines: {string} = { label, ("="):rep(#label), "-----BEGIN CERTIFICATE-----" }
  for at = 1, #encoded, 64 do
    lines[#lines + 1] = encoded:sub(at, at + 63)
  end
  lines[#lines + 1] = "-----END CERTIFICATE-----"
  return table.concat(lines, "\n")
end

--- One root of the vendored bundle: a certificate the TLS stack reads,
--- among the generated bytes it does not.
local real = (assert(roots.parse((assert(Fs.read("vendor/cacert/cacert.pem"))))))[1].der

local function test_a_bundle_parses_back_or_is_refused(tmp: string)
  Fuzz.run({
    name = "pem bundle",
    dir = tmp,
    gen = function(src: Fuzz.Source): string
      local ders: {string} = {}
      local blocks: {string} = { "## Bundle", "" }
      while Fuzz.more(src, #ders, 6) do
        local der = src:int(0, 2) == 0 and real or
          sequence(Fuzz.bytes(src, 300) .. ("c"):rep(src:int(0, 1) * 200))
        ders[#ders + 1] = der
        blocks[#blocks + 1] = block(der, "Root " .. #ders)
        blocks[#blocks + 1] = ""
      end
      local text = table.concat(blocks, "\n")
      local mutated = Fuzz.mutate(src, text, 3)
      return Fuzz.pack({ mutated, mutated == text and table.concat(ders, "\0\0") or "" })
    end,
    check = function(input: string): boolean, string
      local fields = Fuzz.unpack(input)
      local found, trouble = roots.parse(fields[1])
      if found == nil then
        Fuzz.label("refused")
        if trouble == "" then return false, "refused without a reason" end
        return true, ""
      end
      Fuzz.label("parsed")
      local ders: {string} = {}
      for _, one in ipairs(found) do
        if one.der == "" then return false, "an empty certificate" end
        -- The TLS stack's own parse, on whatever bytes a bundle holds:
        -- an answer, never a raise.
        local readable, why = Http.check_certificate(one.der)
        Fuzz.label(readable and "readable" or "unreadable")
        if not readable and why == "" then return false, "unreadable without a reason" end
        ders[#ders + 1] = one.der
      end
      if fields[2] ~= "" and table.concat(ders, "\0\0") ~= fields[2] then
        return false, "a well-formed bundle did not parse back as written"
      end
      return true, ""
    end,
    requires = { "parsed", "refused", "readable", "unreadable" },
  })
end

local function test_a_mozilla_date_is_read_or_absent(tmp: string)
  local sample = "##\n## Certificate data from Mozilla as of: Thu Aug 13 03:12:01 2026 GMT\n##\n"
  Fuzz.run({
    name = "mozilla date",
    dir = tmp,
    gen = function(src: Fuzz.Source): string
      return Fuzz.mutate(src, sample, 3)
    end,
    check = function(input: string): boolean, string
      local date = refresh.cacert_date(input)
      if date == nil then
        Fuzz.label("absent")
        return true, ""
      end
      Fuzz.label("dated")
      local day = math.tointeger(tonumber(date:sub(-2))) or 0
      if not date:match("^%d%d%d%d%-%d%d%-%d%d$") or day < 1 or day > 31 then
        return false, "not a date: " .. date
      end
      return true, ""
    end,
    requires = { "dated", "absent" },
  })
end

local function test_pypis_description_is_read_or_refused(tmp: string)
  local sample = Json.encode({
    info = { version = "2099.1" },
    urls = {
      { packagetype = "sdist", url = "https://example.com/tzdata-2099.1.tar.gz",
        digests = { sha256 = ("a"):rep(64) } },
    },
  })
  Fuzz.run({
    name = "tzdata index",
    dir = tmp,
    gen = function(src: Fuzz.Source): string
      return Fuzz.mutate(src, sample, 4)
    end,
    check = function(input: string): boolean, string
      local source, trouble = refresh.tzdata_release(input)
      if source == nil then
        Fuzz.label("refused")
        if trouble == "" then return false, "refused without a reason" end
        return true, ""
      end
      Fuzz.label("found")
      if not source.version:match("^[%w%.]+$") then
        return false, "a version that is not plain: " .. source.version
      end
      if #source.sha256 ~= 64 or not source.sha256:match("^[0-9a-f]+$") then
        return false, "a sha256 that is not 64 lowercase hex digits: " .. source.sha256
      end
      return true, ""
    end,
    requires = { "found", "refused" },
  })
end
