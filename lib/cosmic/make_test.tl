#!/usr/bin/env cosmic
-- test cosmic.make module

local make = require("cosmic.make")
local fs = require("cosmic.fs")
local unix = require("cosmo.unix")
local path = require("cosmo.path")

local TEST_TMPDIR = os.getenv("TEST_TMPDIR")

local function setup(): string
  local test_dir = path.join(TEST_TMPDIR, "make_test")
  unix.makedirs(test_dir)
  return test_dir
end

local function teardown(test_dir: string)
  if test_dir then
    unix.rmrf(test_dir)
  end
end

local function touch(filepath: string, content?: string)
  local dir = path.dirname(filepath)
  if dir ~= "." then
    unix.makedirs(dir)
  end
  local f = io.open(filepath, "w")
  if f then
    f:write(content or "")
    f:close()
  end
end

-- Test scan classifies files correctly
local function test_scan_classification()
  local test_dir = setup()
  touch(path.join(test_dir, "foo.tl"), "-- source")
  touch(path.join(test_dir, "bar.tl"), "-- source")
  touch(path.join(test_dir, "foo_test.tl"), "-- test")
  touch(path.join(test_dir, "bar_example.tl"), "-- example")

  local project = make.scan(test_dir)

  assert(#project.sources == 2, "expected 2 sources, got " .. #project.sources)
  assert(#project.tests == 1, "expected 1 test, got " .. #project.tests)
  assert(#project.examples == 1, "expected 1 example, got " .. #project.examples)

  -- Check correct files in each category
  local found_foo = false
  local found_bar = false
  for _, s in ipairs(project.sources) do
    if s:match("foo%.tl$") then found_foo = true end
    if s:match("bar%.tl$") then found_bar = true end
  end
  assert(found_foo, "expected foo.tl in sources")
  assert(found_bar, "expected bar.tl in sources")

  local found_test = false
  for _, t in ipairs(project.tests) do
    if t:match("foo_test%.tl$") then found_test = true end
  end
  assert(found_test, "expected foo_test.tl in tests")

  local found_example = false
  for _, e in ipairs(project.examples) do
    if e:match("bar_example%.tl$") then found_example = true end
  end
  assert(found_example, "expected bar_example.tl in examples")

  teardown(test_dir)
end
test_scan_classification()

-- Test scan with empty directory
local function test_scan_empty()
  local test_dir = setup()

  local project = make.scan(test_dir)

  assert(#project.sources == 0, "expected 0 sources, got " .. #project.sources)
  assert(#project.tests == 0, "expected 0 tests, got " .. #project.tests)
  assert(#project.examples == 0, "expected 0 examples, got " .. #project.examples)

  teardown(test_dir)
end
test_scan_empty()

-- Test scan with subdirectories
local function test_scan_subdirs()
  local test_dir = setup()
  unix.makedirs(path.join(test_dir, "sub"))
  touch(path.join(test_dir, "top.tl"), "-- top")
  touch(path.join(test_dir, "sub", "deep.tl"), "-- deep")
  touch(path.join(test_dir, "sub", "deep_test.tl"), "-- deep test")

  local project = make.scan(test_dir)

  assert(#project.sources == 2, "expected 2 sources, got " .. #project.sources)
  assert(#project.tests == 1, "expected 1 test, got " .. #project.tests)

  teardown(test_dir)
end
test_scan_subdirs()

-- Test generate produces expected targets
local function test_generate_targets()
  local project = {
    sources = {"foo.tl", "bar.tl"},
    tests = {"foo_test.tl"},
    examples = {"bar_example.tl"},
  }

  local output = make.generate(project)

  -- Check header
  assert(output:match("Generated by cosmic"), "expected header comment")

  -- Check variables
  assert(output:match("COSMIC %?= cosmic"), "expected COSMIC variable")
  assert(output:match("SRC_DIR %?= %."), "expected SRC_DIR variable")
  assert(output:match("BUILD_DIR %?= o"), "expected BUILD_DIR variable")

  -- Check source lists
  assert(output:match("foo%.tl"), "expected foo.tl in sources")
  assert(output:match("bar%.tl"), "expected bar.tl in sources")
  assert(output:match("foo_test%.tl"), "expected foo_test.tl in tests")
  assert(output:match("bar_example%.tl"), "expected bar_example.tl in examples")

  -- Check targets
  assert(output:match("all: build"), "expected all target")
  assert(output:match("build: %$%(lua_files%)"), "expected build target")
  assert(output:match("check:"), "expected check target")
  assert(output:match("format:"), "expected format target")
  assert(output:match("test:"), "expected test target")
  assert(output:match("ci: format check test"), "expected ci target")
  assert(output:match("clean:"), "expected clean target")

  -- Check pattern rules
  assert(output:match("%$%(BUILD_DIR%)/%%%.lua: %%%.tl"), "expected compile pattern rule")
  assert(output:match("%-%-compile"), "expected --compile in rules")
  assert(output:match("%-%-check%-types"), "expected --check-types in rules")
  assert(output:match("%-%-check%-format"), "expected --check-format in rules")
  assert(output:match("%-%-test"), "expected --test in rules")
  assert(output:match("%-%-report"), "expected --report in rules")
end
test_generate_targets()

-- Test generate with empty project
local function test_generate_empty()
  local project = {
    sources = {},
    tests = {},
    examples = {},
  }

  local output = make.generate(project)

  assert(output:match("Generated by cosmic"), "expected header even for empty project")
  assert(output:match("all: build"), "expected all target")
  assert(output:match("ci: format check test"), "expected ci target")
end
test_generate_empty()

-- Test generate with custom config
local function test_generate_custom_config()
  local project = {
    sources = {"main.tl"},
    tests = {},
    examples = {},
  }

  local output = make.generate(project, {
      source_dir = "src",
      build_dir = "out",
      cosmic_bin = "/usr/local/bin/cosmic",
    })

  assert(output:match("COSMIC %?= /usr/local/bin/cosmic"), "expected custom COSMIC")
  assert(output:match("SRC_DIR %?= src"), "expected custom SRC_DIR")
  assert(output:match("BUILD_DIR %?= out"), "expected custom BUILD_DIR")
end
test_generate_custom_config()

-- Test generate includes cosmic.mk
local function test_generate_includes_cosmic_mk()
  local project = {
    sources = {"foo.tl"},
    tests = {},
    examples = {},
  }

  local output = make.generate(project)

  assert(output:match("^%-include cosmic%.mk"), "expected -include cosmic.mk at top")
end
test_generate_includes_cosmic_mk()

print("all make tests passed")
