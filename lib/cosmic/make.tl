--- Generate Makefiles for Teal projects.
--- Scans a directory for .tl files, classifies them, and emits a
--- self-contained Makefile with rules for compile, type-check,
--- format-check, test, and report.

local fs = require("cosmic.fs")

--- Configuration for Makefile generation.
local record Config
  source_dir: string
  build_dir: string
  cosmic_bin: string
end

--- Classified project files.
local record Project
  sources: {string}
  tests: {string}
  examples: {string}
end

--- Default configuration values.
local default_config: Config = {
  source_dir = ".",
  build_dir = "o",
  cosmic_bin = "cosmic",
}

--- Scan a directory for .tl files and classify them.
--- Files ending in _test.tl are tests, _example.tl are examples,
--- all others are sources.
--- @param dir string Directory to scan
--- @return Project Classified project files
local function scan(dir: string): Project
  local project: Project = {
    sources = {},
    tests = {},
    examples = {},
  }

  local files = (fs.collect(dir, "*.tl") or {}) as {string} -- cast: or keeps nil union
  table.sort(files)

  for _, path in ipairs(files) do
    -- Extract relative path from dir prefix
    local rel = path
    if dir ~= "." and dir ~= "" then
      local prefix = dir:gsub("([%.%^%$%(%)%%])", "%%%1")
      rel = path:gsub("^" .. prefix .. "/", "")
    end

    local base = fs.basename(rel)
    if base:match("_test%.tl$") then
      table.insert(project.tests, rel)
    elseif base:match("_example%.tl$") then
      table.insert(project.examples, rel)
    else
      table.insert(project.sources, rel)
    end
  end

  return project
end

--- Generate a Makefile string from a classified project.
--- @param project Project The classified project files
--- @param config Config Optional configuration (uses defaults if nil)
--- @return string The generated Makefile content
local function generate(project: Project, config?: Config): string
  local cfg = config or default_config
  local src_dir = cfg.source_dir or default_config.source_dir
  local build_dir = cfg.build_dir or default_config.build_dir
  local cosmic = cfg.cosmic_bin or default_config.cosmic_bin

  local lines: {string} = {}

  local function add(s: string)
    table.insert(lines, s)
  end

  add("# Generated by cosmic --make")
  add("# https://github.com/whilp/cosmic")
  add("")
  add("-include cosmic.mk")
  add("")
  add("COSMIC ?= " .. cosmic)
  add("SRC_DIR ?= " .. src_dir)
  add("BUILD_DIR ?= " .. build_dir)
  add("")

  -- Source lists
  add("sources := \\")
  if #project.sources > 0 then
    for i, src in ipairs(project.sources) do
      if i < #project.sources then
        add("  " .. src .. " \\")
      else
        add("  " .. src)
      end
    end
  end
  add("")

  add("tests := \\")
  if #project.tests > 0 then
    for i, t in ipairs(project.tests) do
      if i < #project.tests then
        add("  " .. t .. " \\")
      else
        add("  " .. t)
      end
    end
  end
  add("")

  add("examples := \\")
  if #project.examples > 0 then
    for i, e in ipairs(project.examples) do
      if i < #project.examples then
        add("  " .. e .. " \\")
      else
        add("  " .. e)
      end
    end
  end
  add("")

  -- Derived variables
  add("lua_files := $(patsubst %.tl,$(BUILD_DIR)/%.lua,$(sources))")
  add("test_results := $(patsubst %.tl,$(BUILD_DIR)/%.tl.test.got,$(tests))")
  add("")

  -- Default target
  add(".PHONY: all build check format test ci clean")
  add("")
  add("all: build")
  add("")

  -- Build: compile .tl to .lua
  add("## Compile .tl files to .lua")
  add("build: $(lua_files)")
  add("")
  add("$(BUILD_DIR)/%.lua: %.tl")
  add("\t@mkdir -p $(@D)")
  add("\t$(COSMIC) --compile $< > $@")
  add("")

  -- Type check
  add("## Type-check all source and test files")
  add("check: $(sources) $(tests) $(examples)")
  add("\t@for f in $^; do \\")
  add("\t  echo \"check $$f\"; \\")
  add("\t  $(COSMIC) --check-types $$f || exit 1; \\")
  add("\tdone")
  add("")

  -- Format check
  add("## Check formatting on all files")
  add("format: $(sources) $(tests) $(examples)")
  add("\t@for f in $^; do \\")
  add("\t  echo \"format $$f\"; \\")
  add("\t  $(COSMIC) --check-format $$f || exit 1; \\")
  add("\tdone")
  add("")

  -- Test
  add("## Run tests and report results")
  add("test: $(test_results)")
  add("\t$(COSMIC) --report $(test_results)")
  add("")
  add("$(BUILD_DIR)/%.tl.test.got: %.tl")
  add("\t@mkdir -p $(@D)")
  add("\t$(COSMIC) --test $(BUILD_DIR)/$<.test $(COSMIC) $<")
  add("")

  -- CI
  add("## Run format + check + test")
  add("ci: format check test")
  add("")

  -- Clean
  add("## Remove build artifacts")
  add("clean:")
  add("\trm -rf $(BUILD_DIR)")
  add("")

  return table.concat(lines, "\n")
end

--- Scan a directory, generate a Makefile, and optionally pipe to make.
--- @param dir string Directory to scan (nil: print to stdout)
--- @param target string Target to run (nil: run default target)
--- @return boolean, string Success and command or error message
local function run(dir?: string, target?: string): boolean, string
  local scan_dir = dir or "."
  local project = scan(scan_dir)
  local content = generate(project)

  if not dir then
    -- no dir arg: just print to stdout
    io.write(content)
    return true, "stdout"
  end

  -- pipe to make. The target name is interpolated into a shell command, so
  -- reject anything that isn't a plain make target to avoid shell injection
  -- (e.g. a target of `; rm -rf ~` would otherwise run arbitrary commands).
  local cmd = "make -f -"
  if target then
    if not target:match("^[%w._/-]+$") then
      return false, "invalid make target: " .. target
    end
    cmd = cmd .. " " .. target
  end
  local p = io.popen(cmd, "w")
  if not p then
    return false, "failed to start make"
  end
  p:write(content)
  -- close() on a popen'd file reports (true|fail, "exit"|"signal", n).
  -- Branch on truthiness, not on `ok ~= nil`: Lua 5.4's `fail` is nil
  -- today, but the manual only says it "is currently nil" -- a `false`
  -- would make a `~= nil` test read a FAILED make as success, which is
  -- the one shape of bug this build works hardest to avoid.
  local ok, how, code = p:close()
  if ok then
    return true, cmd
  end
  return false, string.format("%s failed: %s %s", cmd,
    how or "unknown", tostring(code))
end

local record MakeModule
  scan: function(dir: string): Project
  generate: function(project: Project, config?: Config): string
  run: function(dir?: string, target?: string): boolean, string
end

return {
  scan = scan,
  generate = generate,
  run = run,
} as MakeModule -- cast: table to module record
