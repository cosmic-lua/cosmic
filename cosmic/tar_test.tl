--- Proves the tar reader and writer against each other, and against
--- fixtures made once, ahead of time, by the system `tar` -- a GNU
--- long-name archive and a pax archive, both holding a plain file, a
--- symlink, and a path that pushes past the ustar 100-byte name limit.
--- Embedded as base64 so this file has no binary bytes of its own and
--- no test here spawns an external program.

local Fs = require("cosmic.fs")
local Stream = require("cosmic.stream")
local Tar = require("cosmic.tar")

local B64_ALPHABET <const> = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function b64_index(): {string:integer}
  local map: {string:integer} = {}
  for i = 1, #B64_ALPHABET do
    map[B64_ALPHABET:sub(i, i)] = i - 1
  end
  return map
end

local B64_INDEX <const> = b64_index()

local function base64_decode(data: string): string
  local out: {string} = {}
  local bits = 0
  local nbits = 0
  for i = 1, #data do
    local c = data:sub(i, i)
    local v = B64_INDEX[c]
    if v ~= nil then
      bits = (bits << 6) | v
      nbits = nbits + 6
      if nbits >= 8 then
        nbits = nbits - 8
        out[#out + 1] = string.char((bits >> nbits) & 0xFF)
      end
    end
  end
  return table.concat(out)
end

local GNU_TAR_B64 <const> =
  ""

local PAX_TAR_B64 <const> =
  ""

--- Every entry a reader visits, draining its body when `read_bodies`,
--- in a stable summary a test can assert on directly.
local function summary(r: Tar.TarReader, read_bodies: boolean): {string} | nil, string
  local lines: {string} = {}
  while true do
    local entry, trouble = r:next()
    if entry == nil then
      if trouble ~= "" then return nil, trouble end
      return lines, ""
    end
    local body = ""
    if read_bodies and entry.kind == "file" then
      local reader = assert(entry:open())
      local data, rtrouble = Stream.read_all(reader)
      if data == nil then return nil, rtrouble end
      body = data
      assert(#data == entry.size, entry.path .. ": size mismatch")
    end
    lines[#lines + 1] = entry.kind .. " " .. entry.path ..
      (entry.kind == "symlink" and (" -> " .. entry.linkpath) or "") ..
      (body ~= "" and (" [" .. body .. "]") or "")
  end
  return lines, ""
end

local function test_writer_and_reader_roundtrip_files_dirs_and_symlinks()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_dir("adir"))
  assert(w:add_file("adir/short.txt", "hello there"))
  assert(w:add_symlink("adir/link", "short.txt"))
  assert(w:close())

  local r = Tar.reader(Stream.from_string(c:result()))
  local lines = assert(summary(r, true))
  table.sort(lines)
  assert(#lines == 3, table.concat(lines, " | "))
  assert(lines[1] == "dir adir/")
  assert(lines[2] == "file adir/short.txt [hello there]")
  assert(lines[3] == "symlink adir/link -> short.txt")
end

local function test_a_long_path_round_trips_through_a_pax_header()
  local long_path = string.rep("a", 40) .. "/" .. string.rep("b", 40) ..
    "/" .. string.rep("c", 40) .. "/file.txt"
  assert(#long_path > 100)
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file(long_path, "payload"))
  assert(w:close())

  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = assert(r:next())
  assert(entry.path == long_path, entry.path)
  assert(Stream.read_all((assert(entry:open()))) == "payload")
  local last, trouble = r:next()
  assert(last == nil and trouble == "")
end

local function test_deterministic_mode_zeroes_mtime_uid_and_gid()
  local c = Stream.collect()
  local w = Tar.writer(c, { deterministic = true })
  assert(w:add_file("f", "x", { mtime = 12345 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = assert(r:next())
  assert(entry.mtime == 0 and entry.uid == 0 and entry.gid == 0)
end

local function test_add_file_from_a_reader_needs_an_explicit_size()
  local c = Stream.collect()
  local w = Tar.writer(c)
  local ok, trouble = w:add_file("f", Stream.from_string("abc"))
  assert(not ok and trouble:find("opts.size", 1, true) ~= nil, trouble)
  -- nothing was written, so the writer is still usable
  assert(w:add_file("g", "x"))
  assert(w:close())
end

local function test_add_file_from_a_reader_streams_the_body()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", Stream.from_string("abcdef"), { size = 6 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = assert(r:next())
  assert(Stream.read_all((assert(entry:open()))) == "abcdef")
end

local function test_a_body_not_opened_is_skipped_automatically()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("first", "one payload here"))
  assert(w:add_file("second", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local first = assert(r:next())
  assert(first.path == "first")
  -- first.open() is never called: next() must skip its body itself
  local second = assert(r:next())
  assert(second.path == "second")
  assert(Stream.read_all((assert(second:open()))) == "two")
end

local function test_an_entry_reader_is_invalid_once_the_next_entry_is_asked_for()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("first", "one"))
  assert(w:add_file("second", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local first = assert(r:next())
  local stale = assert(first:open())
  assert(r:next())
  local chunk, trouble = stale:read()
  assert(chunk == nil and trouble ~= "")
end

--- Big-endian 8-byte two's complement of `n`, sign-extended to a
--- 12-byte GNU base-256 numeric field (the marker bit comes for free:
--- a negative number's sign-extension bytes are already 0xFF).
local function base256_field_12(n: integer): string
  local bytes: {string} = {}
  local fill = n < 0 and 0xFF or 0x00
  for _ = 1, 4 do bytes[#bytes + 1] = string.char(fill) end
  for k = 7, 0, -1 do
    bytes[#bytes + 1] = string.char((n >> (k * 8)) & 0xFF)
  end
  return table.concat(bytes)
end

local function recompute_checksum(block: string): string
  local sum = 256
  for i = 1, 148 do sum = sum + block:byte(i) end
  for i = 157, 512 do sum = sum + block:byte(i) end
  local checksum = string.format("%06o", sum) .. "\0 "
  return block:sub(1, 148) .. checksum .. block:sub(157)
end

local function test_a_negative_base256_mtime_decodes_as_negative()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "x", { mtime = 0 }))
  assert(w:close())
  local raw = c:result()
  local target = -100000 -- well before the Unix epoch
  local patched = raw:sub(1, 136) .. base256_field_12(target) .. raw:sub(149)
  patched = recompute_checksum(patched)
  local r = Tar.reader(Stream.from_string(patched))
  local entry = assert(r:next())
  assert(entry.mtime == target, tostring(entry.mtime))
end

local function test_opening_an_entry_a_second_time_is_refused()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "hello"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = assert(r:next())
  local first = assert(entry:open())
  assert(Stream.read_all(first) == "hello")
  local second, trouble = entry:open()
  assert(second == nil and trouble:find("already opened", 1, true) ~= nil, trouble)
end

local function test_a_corrupt_checksum_is_refused()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "data"))
  assert(w:close())
  local raw = c:result()
  -- flip a byte inside the name field, which the checksum covers
  local corrupt = "X" .. raw:sub(2)
  local r = Tar.reader(Stream.from_string(corrupt))
  local entry, trouble = r:next()
  assert(entry == nil and trouble:find("checksum", 1, true) ~= nil, trouble)
end

local function test_an_empty_stream_ends_the_archive_immediately()
  local r = Tar.reader(Stream.from_string(""))
  local entry, trouble = r:next()
  assert(entry == nil and trouble == "")
end

local function test_gnu_long_name_archive_from_system_tar()
  local raw = base64_decode(GNU_TAR_B64)
  local r = Tar.reader(Stream.from_string(raw))
  local lines = assert(summary(r, true))
  table.sort(lines)
  local joined = table.concat(lines, "\n")
  assert(joined:find("file short.txt [short file contents\n]", 1, true) ~= nil, joined)
  assert(joined:find("symlink adir/alink -> short.txt", 1, true) ~= nil, joined)
  assert(joined:find(
    "thisisaveryveryverylongdirectorynametotesttheustarprefixsplitlogicwhichneedstobelong" ..
    "/anotherlongsubdirectorynametopushthepathpastonehundredcharacters/deep.txt [deep file\n]",
    1, true) ~= nil, joined)
end

local function test_pax_archive_from_system_tar()
  local raw = base64_decode(PAX_TAR_B64)
  local r = Tar.reader(Stream.from_string(raw))
  local lines = assert(summary(r, true))
  table.sort(lines)
  local joined = table.concat(lines, "\n")
  assert(joined:find("file short.txt [short file contents\n]", 1, true) ~= nil, joined)
  assert(joined:find("symlink adir/alink -> short.txt", 1, true) ~= nil, joined)
  assert(joined:find(
    "thisisaveryveryverylongdirectorynametotesttheustarprefixsplitlogicwhichneedstobelong" ..
    "/anotherlongsubdirectorynametopushthepathpastonehundredcharacters/deep.txt [deep file\n]",
    1, true) ~= nil, joined)
end

local function field(s: string, width: integer): string
  return s .. string.rep("\0", width - #s)
end

local function octal(n: integer, width: integer): string
  return string.format("%0" .. tostring(width - 1) .. "o", n) .. "\0"
end

--- A bare ustar header block, for the entries `Tar.writer` would never
--- produce.
local function header(name: string, typeflag: string, size: integer): string
  local block = field(name, 100) .. octal(420, 8) .. octal(0, 8) .. octal(0, 8) ..
    octal(size, 12) .. octal(0, 12) .. string.rep(" ", 8) .. typeflag .. field("", 100) ..
    "ustar\0" .. "00" .. string.rep("\0", 247)
  return recompute_checksum(block)
end

local function padded(body: string): string
  local rem = #body % 512
  if rem == 0 then return body end
  return body .. string.rep("\0", 512 - rem)
end

local END <const> = string.rep("\0", 1024)

local function test_a_pax_header_claiming_a_huge_body_is_refused_without_reading_it()
  local raw = header("PaxHeaders/f", "x", 1 << 30) .. string.rep("\0", 512)
  local r = Tar.reader(Stream.from_string(raw))
  local entry, trouble = r:next()
  assert(entry == nil and trouble:find("limit", 1, true) ~= nil, trouble)
  -- and the failure is sticky
  local again, again_trouble = r:next()
  assert(again == nil and again_trouble == trouble, again_trouble)
end

local function test_a_nul_byte_in_a_pax_path_or_linkpath_is_refused()
  for _, key in ipairs({ "path", "linkpath" }) do
    local rec = " " .. key .. "=evil\0/../x\n"
    rec = tostring(#rec + 2) .. rec
    local raw = header("PaxHeaders/f", "x", #rec) .. padded(rec) .. header("f", "2", 0) .. END
    local r = Tar.reader(Stream.from_string(raw))
    local entry, trouble = r:next()
    assert(entry == nil and trouble:find("NUL", 1, true) ~= nil, key .. ": " .. tostring(trouble))
  end
end

local function pax_rec(key: string, value: string): string
  local rec = " " .. key .. "=" .. value .. "\n"
  local len = #rec
  while #tostring(len) + #rec ~= len do len = #tostring(len) + #rec end
  return tostring(len) .. rec
end

local function test_global_pax_headers_keep_only_the_keys_the_reader_uses()
  -- Forty global headers, each naming a distinct 256 KiB key, used to
  -- stay in memory for the reader's lifetime.
  local parts: {string} = {}
  local big = string.rep("v", 256 * 1024)
  for i = 1, 40 do
    local rec = pax_rec("comment." .. tostring(i), big)
    parts[#parts + 1] = header("PaxHeaders/g", "g", #rec) .. padded(rec)
  end
  local sparse = pax_rec("GNU.sparse.name", "x")
  local mtime = pax_rec("mtime", "12345")
  parts[#parts + 1] = header("PaxHeaders/g", "g", #sparse + #mtime) .. padded(sparse .. mtime)
  parts[#parts + 1] = header("f", "0", 0) .. END
  local r = Tar.reader(Stream.from_string(table.concat(parts)))
  parts = nil
  collectgarbage()
  local before = collectgarbage("count")
  local entry, trouble = r:next()
  assert(entry ~= nil, trouble)
  collectgarbage()
  local grown = collectgarbage("count") - before
  assert(grown < 1024, "reader retained " .. tostring(grown) .. " KiB")
  -- the keys it does use still apply
  assert(entry.kind == "other" and entry.mtime == 12345, entry.kind .. " " .. tostring(entry.mtime))
end

local function test_a_nul_byte_inside_a_gnu_long_name_is_refused()
  local name = "evil\0/../../x\0"
  local raw = header("././@LongLink", "L", #name) .. padded(name) .. header("f", "0", 0) .. END
  local r = Tar.reader(Stream.from_string(raw))
  local entry, trouble = r:next()
  assert(entry == nil and trouble:find("NUL", 1, true) ~= nil, trouble)
end

local function test_typeflag_7_is_a_file_and_sparse_or_unknown_ones_are_other()
  local sparse_rec = " GNU.sparse.major=1\n"
  sparse_rec = tostring(#sparse_rec + 2) .. sparse_rec
  local raw = header("contig", "7", 5) .. padded("hello") ..
    header("gnu-sparse", "S", 3) .. padded("abc") ..
    header("PaxHeaders/p", "x", #sparse_rec) .. padded(sparse_rec) ..
    header("pax-sparse", "0", 2) .. padded("zz") ..
    header("fifo", "6", 0) ..
    header("after", "0", 4) .. padded("tail") .. END
  local r = Tar.reader(Stream.from_string(raw))
  local kinds: {string} = {}
  local last: Tar.Entry
  while true do
    local entry, trouble = r:next()
    assert(trouble == "", trouble)
    if entry == nil then break end
    local e: Tar.Entry = entry
    kinds[#kinds + 1] = e.path .. "=" .. e.kind
    last = e
  end
  assert(table.concat(kinds, ",") ==
    "contig=file,gnu-sparse=other,pax-sparse=other,fifo=other,after=file", table.concat(kinds, ","))
  assert(last.typeflag == "0")
end

local function test_mtimes_outside_the_octal_field_round_trip_through_pax()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("old", "x", { mtime = -86400 }))
  assert(w:add_file("far", "x", { mtime = 1 << 40 }))
  assert(w:add_file("now", "x", { mtime = 1700000000 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local seen: {string:integer} = {}
  while true do
    local entry = r:next()
    if entry == nil then break end
    local e: Tar.Entry = entry
    seen[e.path] = e.mtime
  end
  assert(seen.old == -86400, tostring(seen.old))
  assert(seen.far == 1 << 40, tostring(seen.far))
  assert(seen.now == 1700000000, tostring(seen.now))
end

local function test_a_failed_add_aborts_the_archive_and_fails_every_later_call(tmp: string)
  local path = tmp .. "/out.tar"
  local w = Tar.writer((assert(Stream.create(path))))
  assert(w:add_file("ok", "fine"))
  local ok, trouble = w:add_file("short", Stream.from_string("abc"), { size = 10 })
  assert(not ok and trouble:find("stated size", 1, true) ~= nil, trouble)
  local again = w:add_file("later", "x")
  assert(not again)
  local closed, close_trouble = w:close()
  assert(not closed and close_trouble == trouble, close_trouble)
  assert(Fs.exists(path) == false)
  local left = assert(Fs.list(tmp))
  assert(#left == 0, table.concat(left, ","))
end

local function test_a_writer_refuses_entries_after_close()
  local w = Tar.writer(Stream.collect())
  assert(w:close())
  assert(w:close())
  local ok, trouble = w:add_file("late", "x")
  assert(not ok and trouble:find("closed", 1, true) ~= nil, trouble)
end

local function test_a_file_backed_reader_skips_bodies_and_notices_truncation(tmp: string)
  local path = tmp .. "/a.tar"
  local w = Tar.writer((assert(Stream.create(path))))
  assert(w:add_file("big", string.rep("b", 200000)))
  assert(w:add_file("small", "tiny"))
  assert(w:close())
  local r = Tar.reader((assert(Stream.open(path))))
  assert((assert(r:next())).path == "big")
  local small = assert(r:next())
  assert(small.path == "small" and Stream.read_all((assert(small:open()))) == "tiny")
  assert(r:next() == nil)
  assert(r:close())
  assert(r:close())
  local after, after_trouble = r:next()
  assert(after == nil and after_trouble ~= "")

  -- cut the file inside the first body: skipping it must fail, not end
  local whole = assert(Fs.read(path))
  local cut = tmp .. "/cut.tar"
  assert(Fs.write(cut, whole:sub(1, 100000)))
  local rc = Tar.reader((assert(Stream.open(cut))))
  assert(rc:next())
  local none, trouble = rc:next()
  assert(none == nil and trouble:find("end of archive", 1, true) ~= nil, trouble)
  rc:close()
end

local function test_numeric_and_text_fields_read_to_their_edges()
  -- a name and link name filling their fields with no NUL, a mode with
  -- digits right up to its end, a space-padded uid, a NUL-padded gid
  local name = string.rep("n", 100)
  local link = string.rep("l", 100)
  local block = name .. "00000644" .. "   1750 " .. "31\0\0\0\0\0\0" ..
    octal(0, 12) .. octal(7, 12) .. string.rep(" ", 8) .. "2" .. link ..
    "ustar\0" .. "00" .. string.rep("\0", 247)
  local r = Tar.reader(Stream.from_string(recompute_checksum(block) .. END))
  local entry = assert(r:next())
  assert(entry.path == name, entry.path)
  assert(entry.linkpath == link, entry.linkpath)
  assert(entry.mode == 0x1a4, tostring(entry.mode))
  assert(entry.uid == 1000, tostring(entry.uid))
  assert(entry.gid == 25, tostring(entry.gid))
  assert(entry.mtime == 7, tostring(entry.mtime))
  assert(r:next() == nil)
end

--- A Reader over `data` that hands out at most `step` bytes a read
--- and cannot skip, like a pipe.
local function trickle(data: string, step: integer): Stream.Reader
  local inner = Stream.from_string(data)
  local r: Stream.Reader = {}
  r.read = function(_self: Stream.Reader, max?: integer): string | nil, string
    local want = max or step
    if want > step then want = step end
    return inner:read(want)
  end
  r.close = function(_self: Stream.Reader): boolean, string
    return inner:close()
  end
  return r
end

local function test_bodies_read_and_skipped_through_a_trickling_unseekable_reader()
  local c = Stream.collect()
  local w = Tar.writer(c)
  local big = string.rep("0123456789", 20000)
  assert(w:add_file("a", "first"))
  assert(w:add_file("big", big))
  assert(w:add_file("skipped", string.rep("s", 70000)))
  assert(w:add_file("b", "last"))
  assert(w:close())
  for _, step in ipairs({ 7, 512, 100000 }) do
    local r = Tar.reader(trickle(c:result(), step))
    local a = assert(r:next())
    assert(Stream.read_all((assert(a:open()))) == "first")
    local b = assert(r:next())
    assert(Stream.read_all((assert(b:open()))) == big)
    assert((assert(r:next())).path == "skipped")
    local last = assert(r:next())
    assert(last.path == "b" and Stream.read_all((assert(last:open()))) == "last")
    local none, trouble = r:next()
    assert(none == nil and trouble == "", trouble)
  end
end

local function test_a_stale_entry_cannot_be_opened()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("a", "one"))
  assert(w:add_file("b", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local a = assert(r:next())
  local b = assert(r:next())
  local body, trouble = a:open()
  assert(body == nil and trouble:find("no longer current", 1, true) ~= nil, trouble)
  assert(Stream.read_all((assert(b:open()))) == "two")
end
