--- Proves the tar reader and writer against each other, and against
--- fixtures made once, ahead of time, by the system `tar` -- a GNU
--- long-name archive and a pax archive, both holding a plain file, a
--- symlink, and a path that pushes past the ustar 100-byte name limit.
--- Embedded as base64 so this file has no binary bytes of its own and
--- no test here spawns an external program.

local Codec = require("cosmic.codec")
local Fs = require("cosmic.fs")
local Stream = require("cosmic.stream")
local String = require("cosmic.string")
local Tar = require("cosmic.tar")
local type Failure = require("cosmic.failure")

-- The next entry of `r`, which must be there.
local function entry_of(r: Tar.Reader): Tar.Entry
  local entry, why = r:next()
  assert(entry ~= nil, why)
  assert(entry ~= false, "the archive ended")
  return entry
end

-- Whether `r` has reached its end, failing if it fails.
local function ended(r: Tar.Reader): boolean
  local entry, why = r:next()
  assert(entry ~= nil, why)
  return entry == false
end

local GNU_TAR_B64 <const> =
  ""

local PAX_TAR_B64 <const> =
  ""

--- Every entry a reader visits, draining its body when `read_bodies`,
--- in a stable summary a test can assert on directly.
local function summary(r: Tar.Reader, read_bodies: boolean): {string}?, string
  local lines: mut {string} = {}
  while true do
    local entry, trouble = r:next()
    if entry == nil then return nil, tostring(trouble) end
    if entry == false then return lines, "" end
    local body = ""
    if read_bodies and entry.kind == "file" then
      local reader = assert(entry:open())
      local data, rtrouble = Stream.read_all(reader)
      if data == nil then return nil, tostring(rtrouble) end
      body = data
      assert(#data == entry.size, entry.path .. ": size mismatch")
    end
    lines[#lines + 1] = entry.kind .. " " .. entry.path ..
      (if entry.kind == "symlink" then (" -> " .. entry.linkpath) else "" end) ..
      (if body ~= "" then (" [" .. body .. "]") else "" end)
  end
  return lines, "" -- checked: unreachable
end

local function test_writer_and_reader_roundtrip_files_dirs_and_symlinks()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_dir("adir"))
  assert(w:add_file("adir/short.txt", "hello there"))
  assert(w:add_symlink("adir/link", "short.txt"))
  assert(w:close())

  local r = Tar.reader(Stream.from_string(c:result()))
  local lines = assert(summary(r, true))
  table.sort(lines) -- checked: overload_none
  assert(#lines == 3, table.concat(lines, " | "))
  assert(lines[1] == "dir adir/")
  assert(lines[2] == "file adir/short.txt [hello there]")
  assert(lines[3] == "symlink adir/link -> short.txt")
end

local function test_a_long_path_round_trips_through_a_pax_header()
  local long_path = string.rep("a", 40) .. "/" .. string.rep("b", 40) ..
    "/" .. string.rep("c", 40) .. "/file.txt"
  assert(#long_path > 100)
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file(long_path, "payload"))
  assert(w:close())

  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  assert(entry.path == long_path, entry.path)
  assert(assert(Stream.read_all((assert(entry:open())))) == "payload")
  assert(ended(r))
end

-- Found by tar_fuzz_test.tl: a `/` then 100 bytes split at the leading
-- `/` into an empty ustar prefix, which reads back as none.
local function test_a_leading_slash_survives_a_path_just_past_the_name_field()
  local path = "/" .. string.rep("n", 100)
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file(path, "x"))
  assert(w:close())
  local entry = entry_of(Tar.reader(Stream.from_string(c:result())))
  assert(entry.path == path, entry.path)
end

local function test_deterministic_mode_zeroes_mtime_uid_and_gid()
  local c = Stream.collect()
  local w = Tar.writer(c, { deterministic = true })
  assert(w:add_file("f", "x", { mtime = 12345 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  assert(entry.mtime == 0 and entry.uid == 0 and entry.gid == 0)
end

local function test_a_size_below_zero_raises()
  local w = Tar.writer(Stream.collect())
  local ok, why: boolean, any = pcall(function()
    local _, _ = w:add_file("f", Stream.from_string("abc"), { size = -1 })
  end)
  assert(not ok and tostring(why):find("tar: opts.size must be at least 0", 1, true) ~= nil,
    tostring(why))
  assert(tostring(why):find("tar_test", 1, true), "blames the caller: " .. tostring(why))
  -- Whatever the body, and before any other refusal of the call.
  for _, call in ipairs({ -- checked: cast_refused
      function() local _, _ = w:add_file("f", "abc", { size = -1 }) end,
      function() local _, _ = w:add_file("dir/", "abc", { size = -1 }) end,
  } as {function()}) do
    ok, why = pcall(call)
    assert(not ok and tostring(why):find("tar: opts.size must be at least 0", 1, true) ~= nil,
      tostring(why))
  end
  assert(w:add_file("g", "x"))
  assert(w:close())
end

local function test_add_file_from_a_reader_needs_an_explicit_size()
  local c = Stream.collect()
  local w = Tar.writer(c)
  local ok, trouble = w:add_file("f", Stream.from_string("abc"))
  assert(not ok and tostring(trouble):find("opts.size", 1, true) ~= nil, tostring(trouble))
  -- nothing was written, so the writer is still usable
  assert(w:add_file("g", "x"))
  assert(w:close())
end

local function test_add_file_from_a_reader_streams_the_body()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", Stream.from_string("abcdef"), { size = 6 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  assert(assert(Stream.read_all((assert(entry:open())))) == "abcdef")
end

local function test_a_body_not_opened_is_skipped_automatically()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("first", "one payload here"))
  assert(w:add_file("second", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local first = entry_of(r)
  assert(first.path == "first")
  -- first.open() is never called: next() must skip its body itself
  local second = entry_of(r)
  assert(second.path == "second")
  assert(assert(Stream.read_all((assert(second:open())))) == "two")
end

local function test_an_entry_reader_is_invalid_once_the_next_entry_is_asked_for()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("first", "one"))
  assert(w:add_file("second", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local first = entry_of(r)
  local stale = assert(first:open())
  entry_of(r)
  local chunk, _ = stale:read()
  assert(chunk == nil)
end

--- Big-endian 8-byte two's complement of `n`, sign-extended to a
--- 12-byte GNU base-256 numeric field (the marker bit comes for free:
--- a negative number's sign-extension bytes are already 0xFF).
local function base256_field_12(n: integer): string
  local bytes: mut {string} = {}
  local fill = if n < 0 then 0xFF else 0x00 end
  for _ = 1, 4 do bytes[#bytes + 1] = string.char(fill) end
  for k = 7, 0, -1 do
    bytes[#bytes + 1] = string.char((n >> (k * 8)) & 0xFF)
  end
  return table.concat(bytes)
end

local function recompute_checksum(block: string): string
  local sum = 256
  for i = 1, 148 do sum = sum + String.byte_at(block, i) end
  for i = 157, 512 do sum = sum + String.byte_at(block, i) end
  local checksum = string.format("%06o", sum) .. "\0 "
  return block:sub(1, 148) .. checksum .. block:sub(157)
end

local function test_a_negative_base256_mtime_decodes_as_negative()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "x", { mtime = 0 }))
  assert(w:close())
  local raw = c:result()
  local target = -100000 -- well before the Unix epoch
  local patched = raw:sub(1, 136) .. base256_field_12(target) .. raw:sub(149)
  patched = recompute_checksum(patched)
  local r = Tar.reader(Stream.from_string(patched))
  local entry = entry_of(r)
  assert(entry.mtime == target, tostring(entry.mtime))
end

--- A one-file archive with the 12-byte field at `off` replaced by
--- `field`, its checksum written again.
local function with_field_12(off: integer, field: string): string
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "x", { mtime = 0 }))
  assert(w:close())
  local raw = c:result()
  return recompute_checksum(raw:sub(1, off - 1) .. field .. raw:sub(off + 12))
end

local function test_a_base256_size_past_64_bits_is_refused_not_wrapped()
  -- 2^64: its low 64 bits, all a wrap would keep, say 0.
  local archive = with_field_12(125, "\x80\0\0\x01" .. string.rep("\0", 8))
  local entry, trouble = Tar.reader(Stream.from_string(archive)):next()
  assert(entry == nil and tostring(trouble):find("size field", 1, true) ~= nil, tostring(trouble))
end

local function test_a_base256_mtime_past_64_bits_either_way_is_refused()
  -- 2^63, and -2^63 - 1: each one past an end of the integer range.
  for _, field in ipairs({
      "\x80\0\0\0\x80" .. string.rep("\0", 7),
      "\xff\xff\xff\xff\x7f" .. string.rep("\xff", 7),
  }) do
    local entry, trouble = Tar.reader(Stream.from_string(with_field_12(137, field))):next()
    assert(entry == nil and tostring(trouble):find("mtime field", 1, true) ~= nil, tostring(trouble))
  end
end

local function test_a_base256_mtime_at_either_end_of_the_integer_range_is_read()
  for _, n in ipairs({ math.maxinteger, math.mininteger }) do
    -- A positive value's first byte needs the marker bit set.
    local field = base256_field_12(n)
    field = string.char(String.byte_at(field, 1) | 0x80) .. field:sub(2)
    local entry = entry_of(Tar.reader(Stream.from_string(with_field_12(137, field))))
    assert(entry.mtime == n, tostring(entry.mtime))
  end
end

local function test_opening_an_entry_a_second_time_is_refused()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "hello"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  local first = assert(entry:open())
  assert(assert(Stream.read_all(first)) == "hello")
  local second, trouble = entry:open()
  assert(second == nil and tostring(trouble):find("already opened", 1, true) ~= nil, tostring(trouble))
end

local function test_a_corrupt_checksum_is_refused()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", "data"))
  assert(w:close())
  local raw = c:result()
  -- flip a byte inside the name field, which the checksum covers
  local corrupt = "X" .. raw:sub(2)
  local r = Tar.reader(Stream.from_string(corrupt))
  local entry, trouble = r:next()
  assert(entry == nil and tostring(trouble):find("checksum", 1, true) ~= nil, tostring(trouble))
end

local function test_an_empty_stream_ends_the_archive_immediately()
  local r = Tar.reader(Stream.from_string(""))
  assert(ended(r))
end

local function test_gnu_long_name_archive_from_system_tar()
  local raw = assert(Codec.unbase64(GNU_TAR_B64))
  local r = Tar.reader(Stream.from_string(raw))
  local lines = assert(summary(r, true))
  table.sort(lines) -- checked: overload_none
  local joined = table.concat(lines, "\n")
  assert(joined:find("file short.txt [short file contents\n]", 1, true) ~= nil, joined)
  assert(joined:find("symlink adir/alink -> short.txt", 1, true) ~= nil, joined)
  assert(joined:find(
    "thisisaveryveryverylongdirectorynametotesttheustarprefixsplitlogicwhichneedstobelong" ..
      "/anotherlongsubdirectorynametopushthepathpastonehundredcharacters/deep.txt [deep file\n]",
    1, true) ~= nil, joined)
end

local function test_pax_archive_from_system_tar()
  local raw = assert(Codec.unbase64(PAX_TAR_B64))
  local r = Tar.reader(Stream.from_string(raw))
  local lines = assert(summary(r, true))
  table.sort(lines) -- checked: overload_none
  local joined = table.concat(lines, "\n")
  assert(joined:find("file short.txt [short file contents\n]", 1, true) ~= nil, joined)
  assert(joined:find("symlink adir/alink -> short.txt", 1, true) ~= nil, joined)
  assert(joined:find(
    "thisisaveryveryverylongdirectorynametotesttheustarprefixsplitlogicwhichneedstobelong" ..
      "/anotherlongsubdirectorynametopushthepathpastonehundredcharacters/deep.txt [deep file\n]",
    1, true) ~= nil, joined)
end

local function field(s: string, width: integer): string
  return s .. string.rep("\0", width - #s)
end

local function octal(n: integer, width: integer): string
  return string.format("%0" .. tostring(width - 1) .. "o", n) .. "\0"
end

--- A bare ustar header block, for the entries [`Tar.writer`] would never
--- produce.
local function header(name: string, typeflag: string, size: integer): string
  local block = field(name, 100) .. octal(420, 8) .. octal(0, 8) .. octal(0, 8) ..
    octal(size, 12) .. octal(0, 12) .. string.rep(" ", 8) .. typeflag .. field("", 100) ..
    "ustar\0" .. "00" .. string.rep("\0", 247)
  return recompute_checksum(block)
end

local function padded(body: string): string
  local rem = #body % 512
  if rem == 0 then return body end
  return body .. string.rep("\0", 512 - rem)
end

local END <const> = string.rep("\0", 1024)

local function test_a_pax_header_claiming_a_huge_body_is_refused_without_reading_it()
  local raw = header("PaxHeaders/f", "x", 1 << 30) .. string.rep("\0", 512)
  local r = Tar.reader(Stream.from_string(raw))
  local entry, trouble = r:next()
  assert(entry == nil and tostring(trouble):find("limit", 1, true) ~= nil, tostring(trouble))
  -- and the failure is sticky
  local again, again_trouble = r:next()
  assert(again == nil and tostring(again_trouble) == tostring(trouble), tostring(again_trouble))
end

local function test_a_nul_byte_in_a_pax_path_or_linkpath_is_refused()
  for _, key in ipairs({ "path", "linkpath" }) do
    local rec = " " .. key .. "=evil\0/../x\n"
    rec = tostring(#rec + 2) .. rec
    local raw = header("PaxHeaders/f", "x", #rec) .. padded(rec) .. header("f", "2", 0) .. END
    local r = Tar.reader(Stream.from_string(raw))
    local entry, trouble = r:next()
    assert(entry == nil and tostring(trouble):find("NUL", 1, true) ~= nil, key .. ": " .. tostring(trouble))
  end
end

local function pax_rec(key: string, value: string): string
  local rec = " " .. key .. "=" .. value .. "\n"
  local len = #rec
  while #tostring(len) + #rec ~= len do len = #tostring(len) + #rec end
  return tostring(len) .. rec
end

--- An archive of forty global pax headers, each naming a distinct
--- 256 KiB key, then one file. The pieces it joins go out of scope on
--- return, so only the reader holds the archive.
local function global_pax_archive(): string
  local parts: mut {string} = {}
  local big = string.rep("v", 256 * 1024)
  for i = 1, 40 do
    local rec = pax_rec("comment." .. tostring(i), big)
    table.insert(parts, header("PaxHeaders/g", "g", #rec) .. padded(rec))
  end
  local sparse = pax_rec("GNU.sparse.name", "x")
  local mtime = pax_rec("mtime", "12345")
  table.insert(parts, header("PaxHeaders/g", "g", #sparse + #mtime) .. padded(sparse .. mtime))
  table.insert(parts, header("f", "0", 0) .. END)
  return table.concat(parts)
end

local function test_global_pax_headers_keep_only_the_keys_the_reader_uses()
  -- Forty global headers, each naming a distinct 256 KiB key, would
  -- stay in memory for the reader's lifetime if every key were kept.
  local r = Tar.reader(Stream.from_string(global_pax_archive()))
  collectgarbage()
  local before = collectgarbage("count")
  local entry = entry_of(r)
  collectgarbage()
  local grown = collectgarbage("count") - before
  assert(grown < 1024, "reader retained " .. tostring(grown) .. " KiB")
  -- the keys it does use still apply
  assert(entry.kind == "other" and entry.mtime == 12345, entry.kind .. " " .. tostring(entry.mtime))
end

local function test_a_nul_byte_inside_a_gnu_long_name_is_refused()
  local name = "evil\0/../../x\0"
  local raw = header("././@LongLink", "L", #name) .. padded(name) .. header("f", "0", 0) .. END
  local r = Tar.reader(Stream.from_string(raw))
  local entry, trouble = r:next()
  assert(entry == nil and tostring(trouble):find("NUL", 1, true) ~= nil, tostring(trouble))
end

local function test_typeflag_7_is_a_file_and_sparse_or_unknown_ones_are_other()
  local sparse_rec = " GNU.sparse.major=1\n"
  sparse_rec = tostring(#sparse_rec + 2) .. sparse_rec
  local raw = header("contig", "7", 5) .. padded("hello") ..
    header("gnu-sparse", "S", 3) .. padded("abc") ..
    header("PaxHeaders/p", "x", #sparse_rec) .. padded(sparse_rec) ..
    header("pax-sparse", "0", 2) .. padded("zz") ..
    header("fifo", "6", 0) ..
    header("after", "0", 4) .. padded("tail") .. END
  local r = Tar.reader(Stream.from_string(raw))
  local kinds: mut {string} = {}
  local last: Tar.Entry?
  while true do
    local entry, trouble = r:next()
    assert(entry ~= nil, trouble)
    if entry == false then break end
    local e: Tar.Entry = entry
    kinds[#kinds + 1] = e.path .. "=" .. e.kind
    last = e
  end
  assert(table.concat(kinds, ",") ==
      "contig=file,gnu-sparse=other,pax-sparse=other,fifo=other,after=file", table.concat(kinds, ","))
  assert(last ~= nil and last.typeflag == "0")
end

local function test_mtimes_outside_the_octal_field_round_trip_through_pax()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("old", "x", { mtime = -86400 }))
  assert(w:add_file("far", "x", { mtime = 1 << 40 }))
  assert(w:add_file("now", "x", { mtime = 1700000000 }))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local seen: mut {string:integer} = {}
  while true do
    local entry, trouble = r:next()
    assert(entry ~= nil, trouble)
    if entry == false then break end
    local e: Tar.Entry = entry
    seen[e.path] = e.mtime
  end
  assert(seen.old == -86400, tostring(seen.old)) -- checked: map_field*2
  assert(seen.far == 1 << 40, tostring(seen.far)) -- checked: map_field*2
  assert(seen.now == 1700000000, tostring(seen.now)) -- checked: map_field*2
end

local function test_a_failed_add_aborts_the_archive_and_fails_every_later_call(tmp: string)
  local path = tmp .. "/out.tar"
  local w = Tar.writer((assert(Stream.create(path))))
  assert(w:add_file("ok", "fine"))
  local ok, trouble = w:add_file("short", Stream.from_string("abc"), { size = 10 })
  assert(not ok and tostring(trouble):find("stated size", 1, true) ~= nil, tostring(trouble))
  local again, _ = w:add_file("later", "x")
  assert(not again)
  local closed, close_trouble = w:close()
  assert(not closed and close_trouble == trouble, close_trouble)
  assert(not assert(Fs.status(path)).exists)
  local left = assert(Fs.list(tmp))
  assert(#left == 0, table.concat(left, ","))
end

local function test_a_writer_refuses_entries_after_close()
  local w = Tar.writer(Stream.collect())
  assert(w:close())
  assert(w:close())
  local ok, trouble = w:add_file("late", "x")
  assert(not ok and tostring(trouble):find("closed", 1, true) ~= nil, tostring(trouble))
end

local function test_a_file_backed_reader_skips_bodies_and_notices_truncation(tmp: string)
  local path = tmp .. "/a.tar"
  local w = Tar.writer((assert(Stream.create(path))))
  assert(w:add_file("big", string.rep("b", 200000)))
  assert(w:add_file("small", "tiny"))
  assert(w:close())
  local r = Tar.reader((assert(Stream.open(path))))
  assert(entry_of(r).path == "big")
  local small = entry_of(r)
  assert(small.path == "small" and assert(Stream.read_all((assert(small:open())))) == "tiny")
  assert(ended(r))
  assert(r:close())
  assert(r:close())
  local after, _ = r:next()
  assert(after == nil)

  -- cut the file inside the first body: skipping it must fail, not end
  local whole = assert(Fs.read(path))
  local cut = tmp .. "/cut.tar"
  assert(Fs.write(cut, whole:sub(1, 100000)))
  local rc = Tar.reader((assert(Stream.open(cut))))
  local _ = entry_of(rc)
  local none, trouble = rc:next()
  assert(none == nil and
      tostring(trouble) == "tar: cannot skip to the next entry: stream: skip past the end of the file",
    tostring(trouble))
  local _, _ = rc:close()
end

local function test_numeric_and_text_fields_read_to_their_edges()
  -- a name and link name filling their fields with no NUL, a mode with
  -- digits right up to its end, a space-padded uid, a NUL-padded gid
  local name = string.rep("n", 100)
  local link = string.rep("l", 100)
  local block = name .. "00000644" .. "   1750 " .. "31\0\0\0\0\0\0" ..
    octal(0, 12) .. octal(7, 12) .. string.rep(" ", 8) .. "2" .. link ..
    "ustar\0" .. "00" .. string.rep("\0", 247)
  local r = Tar.reader(Stream.from_string(recompute_checksum(block) .. END))
  local entry = entry_of(r)
  assert(entry.path == name, entry.path)
  assert(entry.linkpath == link, entry.linkpath)
  assert(entry.mode == 0x1a4, tostring(entry.mode))
  assert(entry.uid == 1000, tostring(entry.uid))
  assert(entry.gid == 25, tostring(entry.gid))
  assert(entry.mtime == 7, tostring(entry.mtime))
  assert(ended(r))
end

--- A Reader over `data` that hands out at most `step` bytes a read
--- and cannot skip, like a pipe.
local function trickle(data: string, step: integer): Stream.Reader
  local inner = Stream.from_string(data)
  local r: Stream.Reader = { -- checked: literal_shape
    read = function(_self: Stream.Reader, max_bytes?: integer): (string | false) | (nil, Failure)
      local want = max_bytes or step
      if want > step then want = step end
      return inner:read(want)
    end,
    close = function(_self: Stream.Reader): (true) | (nil, Failure)
      return inner:close()
    end,
  }
  return r
end

local function test_bodies_read_and_skipped_through_a_trickling_unseekable_reader()
  local c = Stream.collect()
  local w = Tar.writer(c)
  local big = string.rep("0123456789", 20000)
  assert(w:add_file("a", "first"))
  assert(w:add_file("big", big))
  assert(w:add_file("skipped", string.rep("s", 70000)))
  assert(w:add_file("b", "last"))
  assert(w:close())
  for _, step in ipairs({ 7, 512, 100000 }) do
    local r = Tar.reader(trickle(c:result(), step))
    local a = entry_of(r)
    assert(assert(Stream.read_all((assert(a:open())))) == "first")
    local b = entry_of(r)
    assert(assert(Stream.read_all((assert(b:open())))) == big)
    assert(entry_of(r).path == "skipped")
    local last = entry_of(r)
    assert(last.path == "b" and assert(Stream.read_all((assert(last:open())))) == "last")
    assert(ended(r))
  end
end

local function test_a_stale_entry_cannot_be_opened()
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("a", "one"))
  assert(w:add_file("b", "two"))
  assert(w:close())
  local r = Tar.reader(Stream.from_string(c:result()))
  local a = entry_of(r)
  local b = entry_of(r)
  local body, trouble = a:open()
  assert(body == nil and tostring(trouble):find("no longer current", 1, true) ~= nil, tostring(trouble))
  assert(assert(Stream.read_all((assert(b:open())))) == "two")
end

local function test_a_reader_body_is_read_to_its_stated_size_and_no_further()
  local source = Stream.from_string("abcdefghij")
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", source, { size = 4 }))
  assert(w:close())
  assert(assert(Stream.read_all(source)) == "efghij", "the writer read past its stated size")
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  assert(entry.size == 4 and assert(Stream.read_all((assert(entry:open())))) == "abcd")
end

local function test_a_failing_body_names_what_the_writer_was_doing()
  local w = Tar.writer(Stream.collect())
  local bad: Stream.Reader = { -- checked: literal_shape
    read = function(_self: Stream.Reader, _max_bytes?: integer): (string | false) | (nil, Failure)
      return nil, Failure.new("disk on fire")
    end,
    close = function(_self: Stream.Reader): (true) | (nil, Failure) return true end,
  }
  local ok, trouble = w:add_file("f", bad, { size = 3 })
  assert(not ok and tostring(trouble) == "tar: add_file: disk on fire", tostring(trouble))
  do
    local done, _ = w:add_file("g", "x")
    assert(not done)
  end
end

local function test_a_link_target_holding_a_nul_byte_is_refused()
  local w = Tar.writer(Stream.collect())
  local ok, trouble = w:add_symlink("l", "a\0b")
  assert(not ok and tostring(trouble) == "tar: NUL byte in a link target", tostring(trouble))
  -- A refused argument is not a failed write.
  assert(w:add_symlink("l", "ok"))
end

--- A failing Writer's own words are returned by the writer as they
--- are; a failing body Reader's are told what the writer was doing.
local function test_a_failing_underlying_writer_is_answered_as_it_said_it()
  local function closed(_self: Stream.Writer): (true) | (nil, Failure) return true end
  local full: Stream.Writer = { -- checked: literal_shape
    write = function(_self: Stream.Writer, _data: string): (true) | (nil, Failure)
      return nil, Failure.new("disk full")
    end,
    close = closed, abort = closed,
  }
  local w = Tar.writer(full)
  local ok, trouble = w:add_file("f", Stream.from_string(string.rep("x", 100000)), { size = 100000 })
  assert(not ok and tostring(trouble) == "disk full", tostring(trouble))
  ok, trouble = w:close()
  assert(not ok and tostring(trouble) == "disk full", tostring(trouble))
end

local function test_a_header_checksum_counts_unsigned_bytes_and_its_own_field_as_spaces()
  local name = ("\255"):rep(20) .. "x"
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file(name, "data"))
  assert(w:close())
  local block = c:result():sub(1, 512)
  local expected = 8 * 32
  for i = 1, 512 do
    if i < 149 or i > 156 then expected = expected + String.byte_at(block, i) end
  end
  assert(expected > 20 * 255)
  assert(tonumber(block:sub(149, 154), 8) == expected, block:sub(149, 156))
  local r = Tar.reader(Stream.from_string(c:result()))
  local entry = entry_of(r)
  assert(entry.path == name, entry.path)
end

local function test_a_header_with_a_checksum_over_high_bytes_is_read()
  local block = header(("\200"):rep(30), "0", 0)
  local r = Tar.reader(Stream.from_string(block .. END))
  local entry = entry_of(r)
  assert(entry.path == ("\200"):rep(30), entry.path)
end

--- `why`'s kind, errno and path and its words, said in an assertion.
local function said(why?: Failure): string
  if why == nil then return "no failure" end
  return why.kind .. " " .. tostring(why.errno) .. " " .. tostring(why.path) .. ": " .. tostring(why)
end

--- Whether `why` is a failure of `kind`, `errno` and `path`.
local function is_failure(why: Failure?, kind: Failure.Kind, errno: integer, path?: string): boolean
  return why ~= nil and why.kind == kind and why.errno == errno and why.path == path
end

--- What [`failing_after`] returns.
local class FailingAfter is Stream.Reader
  mut data: string
  failure: Failure

  function read(self, _max_bytes?: integer): (string | false) | (nil, Failure)
    local data = self.data
    if data == "" then return nil, self.failure end
    self.data = ""
    return data
  end

  function close(self): (true) | (nil, Failure) return true end
end

--- A Reader that gives `data`, as one read, then fails with `failure`.
local function failing_after(data: string, failure: Failure): Stream.Reader
  local r: FailingAfter = { data = data, failure = failure, skip = nil }
  return r
end

local function test_a_failing_source_gives_the_reader_its_failure_as_it_is()
  local timeout = Failure.timeout("read of /dev/tty", "/dev/tty")
  local r = Tar.reader(failing_after("", timeout))
  local none, why = r:next()
  assert(none == nil and why == timeout, said(why))
  local again, again_why = r:next()
  assert(again == nil and again_why == timeout, said(again_why))

  -- A body cut short by its source fails with the source's own Failure,
  -- as does the skip past it, which says what it was doing.
  local c = Stream.collect()
  local w = Tar.writer(c)
  assert(w:add_file("f", string.rep("x", 4096)))
  assert(w:close())
  local head = c:result():sub(1, 1024)
  local body_reader = Tar.reader(failing_after(head, timeout))
  local body = assert(entry_of(body_reader):open())
  local got, body_why = Stream.read_all(body)
  assert(got == nil and body_why == timeout, said(body_why))
  local skipping = Tar.reader(failing_after(head, timeout))
  local _ = entry_of(skipping)
  local skipped, skip_why = skipping:next()
  assert(skipped == nil and is_failure(skip_why, "timeout", 0, "/dev/tty"), said(skip_why))
  assert(tostring(skip_why) == "/dev/tty: tar: cannot skip to the next entry: read of /dev/tty", tostring(skip_why))
end

local function test_a_body_whose_source_times_out_keeps_the_kind_in_the_writer()
  local w = Tar.writer(Stream.collect())
  local ok, why = w:add_file("f", failing_after("", Failure.timeout()), { size = 3 })
  assert(not ok and is_failure(why, "timeout", 0), said(why))
  assert(tostring(why) == "tar: add_file: timed out", tostring(why))
end
